{
  "includeCoAuthoredBy": false,
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(clerk capture:*)",
      "Bash(clerk inbox list)",
      "Bash(clerk inbox show:*)",
      "Bash(clerk inbox dups:*)",
      "Bash(clerk backlog next)",
      "Bash(clerk backlog show:*)",
      "Bash(clerk backlog claim:*)"
    ]
  },
  "model": "opus[1m]",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '$HOME/dotfiles/claude-code/hooks/notify.sh'",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '$HOME/dotfiles/claude-code/hooks/notify.sh'",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "workflowKeywordTriggerEnabled": false,
  "respondToBashCommands": false,
  "statusLine": {
    "type": "command",
    "command": "sh -c '$HOME/dotfiles/ccstatusline/statusline-wrapper.sh'"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers"
      }
    }
  },
  "effortLevel": "xhigh",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
