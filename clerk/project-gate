#!/usr/bin/env bash
# Dotfiles' synchronous Project-gate transform shim.
set -euo pipefail

operation=${1:-}
[ "$operation" = run ] || exit 64
request=$(cat)
worktree=$(printf '%s' "$request" | jq -er '.delivery.worktree')

cpus=$(getconf _NPROCESSORS_ONLN 2>/dev/null || printf '1')
case "$cpus" in
	"" | *[!0-9]*) cpus=1 ;;
esac
jobs=$((cpus / 2))
[ "$jobs" -ge 1 ] || jobs=1

if command -v parallel >/dev/null 2>&1 || command -v rush >/dev/null 2>&1; then
	bats_command=(bats --jobs "$jobs" tests/clerk)
else
	bats_command=(bats tests/clerk)
fi

if (cd "$worktree" && "${bats_command[@]}" && shellcheck -S error bin/*) >&2; then
	status=passed
	summary='bats tests/clerk and shellcheck -S error bin/* passed'
else
	status=failed
	summary='dotfiles validation commands failed'
fi
assessed_commit=$(git -C "$worktree" rev-parse HEAD)
jq -cn --arg status "$status" --arg summary "$summary" --arg assessed_commit "$assessed_commit" \
	'{status: $status, summary: $summary, assessed_commit: $assessed_commit}'
