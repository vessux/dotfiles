#!/usr/bin/env bash
# md — files & URLs -> markdown, for feeding content to agents. Executable form (ADR 0001's
# `bin/` stow package, on PATH via .zshenv) so NON-zsh callers see it too — yazi's `shell`
# block (the `A` key runs `plannotate`, which pipes to `clip`), an agent's own Bash (pi's
# tool shell is /bin/bash, not zsh — it never sourced .zshrc/.zshenv, so the prior zsh
# FUNCTION form was invisible to it; this file fixes that), and `!md` inside a session.
# Same portability argument the other bin/ scripts make (bd/clip/plannotate).
#
#   URL  -> Jina (r.jina.ai): JS render server-side, bypasses agent-blocking, main-content
#           extraction. Auth header only if $JINA_API_KEY is set in the env (keyless
#           otherwise, ~20 req/min). NB: the key for non-interactive callers must be
#           exported in something THIS process's env inherited — .zshrc/.zsh_secrets are
#           interactive-only, so they reach here only via the ancestor shell that launched
#           the session (same inheritance story as ~/.config/bin being on PATH at all).
#   file -> markitdown (PDF/docx/pptx/xlsx; via the mise shims on PATH).
# Stdout only — compose it: `md <url>`, `md <url> | clip`, `md <url> > notes.md`.
set -uo pipefail

if [[ $# -lt 1 || -z "${1:-}" ]]; then
	printf 'usage: md <url|file>\n' >&2
	exit 2
fi

arg="$1"
if [[ "$arg" == http://* || "$arg" == https://* ]]; then
	auth=()
	if [[ -n "${JINA_API_KEY:-}" ]]; then
		auth=(-H "Authorization: Bearer $JINA_API_KEY")
	fi
	exec curl -fsSL --max-time 120 "${auth[@]}" "https://r.jina.ai/$arg"
else
	exec markitdown "$arg"
fi
