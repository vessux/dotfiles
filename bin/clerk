#!/usr/bin/env bash
# clerk — the workflow's single keyless verb facade (ADR 0015). The agent speaks workflow
# verbs; the clerk executes mechanism exactly, in code that cannot drift from itself.
#
# This is the CORE (unit dotfiles-dft.1): noun-verb dispatch, `.clerk` marker resolution
# (ADR 0017: backlog location is a committed marker at the repo root), `doctor`, and
# `--explain`. Every other roster verb refuses with exit 3 until its unit in the
# dotfiles-dft epic lands — a refusal distinct from an unknown verb (exit 2 + roster).
#
# Exit codes:
#   0  success
#   1  doctor found problems
#   2  usage error / verb-level refusal (bad args, unknown verb (roster printed), a
#      criteria-less `backlog claim`, `backlog return` without --reason, `backlog release`
#      of a branch that carries unsubmitted work)
#   3  known verb, not yet implemented in this generation
#   4  dispatch refused: no git repo, or .clerk marker missing/invalid
#   5  a backend command failed / a mutation could not be confirmed (dft.2); for
#      `backlog claim` specifically, a CLAIM CONFLICT — the unit is already occupied or the
#      push-CAS race was lost (dft.3) — a refusal, not an operational failure, so it carries
#      its own prescriptive text instead of backend_fail's "run clerk doctor"
#   6  a delivery-gate ran successfully and found one or more failed proof classes
#
# Output discipline (ADR 0015): printed output is load-bearing — every refusal prescribes
# the next action, and everything is tested verbatim. 16-color ANSI only (30-37/90-97,
# bold, reset; never 38;5/38;2) so terminal themes recolor it. Colour is capability-gated:
# the refusal / roster / doctor strings are parsed and logged downstream, so they must never
# carry escapes into a pipe or file — emit colour only for a real TTY, NO_COLOR (set, any
# value) suppresses it unconditionally, and CLICOLOR_FORCE re-enables it on a non-TTY.
set -uo pipefail

CLERK_VERSION="0.1.0" # single source of truth: --version and doctor both read this line

if [ -n "${NO_COLOR+x}" ]; then
	_clerk_color=0
elif [ -n "${CLICOLOR_FORCE:-}" ] && [ "$CLICOLOR_FORCE" != 0 ]; then
	_clerk_color=1
elif [ -t 1 ]; then
	_clerk_color=1
else
	_clerk_color=0
fi
if [ "$_clerk_color" -eq 1 ]; then
	C_BOLD=$'\033[1m' C_RED=$'\033[31m' C_GRN=$'\033[32m' C_YLW=$'\033[33m' C_RST=$'\033[0m'
else
	C_BOLD='' C_RED='' C_GRN='' C_YLW='' C_RST=''
fi

ADR15="ADR 0015 — umbel/docs/adr/0015-clerk-opaque-workflow-verb-facade.md"
ADR16="ADR 0016 — umbel/docs/adr/0016-delivery-gate-acceptance-proof-and-judgment-loops.md"
ADR17="ADR 0017 — umbel/docs/adr/0017-tier-retired-backlog-location-and-merge-gate-axes.md"

print_roster() {
	printf '%s\n' \
		'Known verbs:' \
		'  capture "<title>" [--stdin|--impediment]' \
		'  inbox list|show|dups|ready|drop|pregrill' \
		'  backlog next|show|claim|release|submit|gate|finish|return' \
		'  sync' \
		'  doctor [--fix --backend bd|gh]' \
		'  glean' \
		"Next: run 'clerk --explain <verb>' to see what a verb does."
}

usage_error() {
	printf '%s\n' "$1" >&2
	exit 2
}

# A backend command (bd/gh) failed, or a mutation could not be confirmed. Exit 5 keeps
# this distinct from doctor's exit 1 (health check) and usage errors (exit 2) — a scripted
# caller can tell "the tracker backend is broken" from "you passed a bad id" (ADR 0015).
backend_fail() {
	printf 'clerk: %s\n' "$1" >&2
	printf "       run 'clerk doctor' to check the backend\n" >&2
	exit 5
}

unknown_verb() {
	printf "clerk: unknown verb '%s'\n" "$1" >&2
	print_roster >&2
	exit 2
}

not_implemented() {
	printf "clerk: '%s' is not yet implemented in this generation (see dotfiles-dft epic)\n" "$1" >&2
	exit 3
}

repo_root() {
	git rev-parse --show-toplevel 2>/dev/null
}

# Parse the .clerk marker at $1. Echoes the backend (bd|gh) on success.
# Returns 1 when the file is missing, 2 when present but invalid.
# Format (ADR 0017 manifest v0): a single directive line `backlog: bd|gh`;
# surrounding whitespace and `#` comments are tolerated.
read_marker() {
	local file="$1" line content=""
	[ -f "$file" ] || return 1
	while IFS= read -r line || [ -n "$line" ]; do
		line="${line%%#*}"                       # strip comments
		line="${line#"${line%%[![:space:]]*}"}"  # ltrim
		line="${line%"${line##*[![:space:]]}"}"  # rtrim
		[ -n "$line" ] || continue
		[ -z "$content" ] || return 2            # more than one directive line
		content="$line"
	done <"$file"
	case "$content" in
		backlog:*) ;;
		*) return 2 ;;
	esac
	content="${content#backlog:}"
	content="${content#"${content%%[![:space:]]*}"}"
	case "$content" in
		bd | gh) printf '%s\n' "$content" ;;
		*) return 2 ;;
	esac
}

# Dispatch gate: every verb except doctor and --explain forms passes through here.
# Refuses (exit 4) unless we are in a git repo with a valid .clerk marker — and always
# prescribes `clerk doctor`, which owns diagnosis and provisioning (ADR 0017).
marker_gate() {
	local root rc=0
	if ! root=$(repo_root); then
		printf "clerk: not inside a git repository — cd into the target repo, then run 'clerk doctor'\n" >&2
		exit 4
	fi
	read_marker "$root/.clerk" >/dev/null || rc=$?
	case "$rc" in
		0) ;;
		1)
			printf "clerk: missing .clerk marker at %s/.clerk — run 'clerk doctor' to provision it\n" "$root" >&2
			exit 4
			;;
		*)
			printf "clerk: invalid .clerk marker at %s/.clerk — run 'clerk doctor' to diagnose it\n" "$root" >&2
			exit 4
			;;
	esac
}

# --explain: the human-terminal window into the facade (ADR 0015) — prints the underlying
# commands a verb runs plus its ADR pointer. Works for every roster verb, implemented or
# not, marker or no marker.
explain_verb() {
	case "$1" in
		capture)
			printf '%s\n' \
				'clerk capture — file one raw capture into the inbox' \
				'  runs: bd create "<title>" [--stdin]           (backlog: bd)' \
				'        gh issue create --title "<title>"       (backlog: gh)' \
				"  see:  $ADR15"
			;;
		sync)
			printf '%s\n' \
				'clerk sync — reconcile every open claim (authorship-free phases only)' \
				'  runs: gh pr view --json state,mergedAt per open claim; then bd close / bd update' \
				'        (backlog: bd) or gh issue close / gh issue edit (backlog: gh) per reconciled' \
				'        state; reclaims stale claims; files reports for judgment-needing states' \
				"  see:  $ADR15"
			;;
		doctor)
			printf '%s\n' \
				'clerk doctor — check and provision workflow plumbing' \
				'  runs: git rev-parse --show-toplevel; reads .clerk; command -v bd vs the shim locations; gh auth status' \
				'        --fix --backend bd|gh writes the .clerk marker' \
				"  see:  $ADR17"
			;;
		glean)
			printf '%s\n' \
				'clerk glean — watermark sweep of session transcripts into captures' \
				'  runs: flock-guarded sweep over per-transcript line offsets (state in ~/.local/state/clerk/); spawns the judgment fork per unharvested chunk' \
				"  see:  $ADR15"
			;;
		'inbox list')
			printf '%s\n' \
				'clerk inbox list — list the unrefined pool' \
				'  runs: bd list, filtered to open minus stage:ready         (backlog: bd)' \
				'        gh issue list, filtered to minus ready-for-agent    (backlog: gh)' \
				"  see:  $ADR15"
			;;
		'inbox show')
			printf '%s\n' \
				'clerk inbox show — show one inbox item' \
				'  runs: bd show <id>          (backlog: bd)' \
				'        gh issue view <id>    (backlog: gh)' \
				"  see:  $ADR15"
			;;
		'inbox dups')
			printf '%s\n' \
				'clerk inbox dups — cluster duplicate captures for pre-sort' \
				'  runs: bd duplicates         (backlog: bd)' \
				'        gh issue list + a similarity pass    (backlog: gh)' \
				"  see:  $ADR16"
			;;
		'inbox ready')
			printf '%s\n' \
				'clerk inbox ready — write refinement output, then promote a groomed unit' \
				'  usage: clerk inbox ready <id> [--design-file <path>] [--acceptance-file <path>] [--returned keep|discard]' \
				'         (gh: --title "<title>" --body-file <path>)' \
				'  runs: for bd, optional bd update --design-file / --acceptance, then refuses' \
				'        units still lacking acceptance criteria (ADR 0016); if returned/<id> exists,' \
				'        requires --returned keep|discard before stage:ready; for gh, creates the' \
				'        ready issue and closes the capture as promoted' \
				"  see:  $ADR16"
			;;
		'inbox drop')
			printf '%s\n' \
				'clerk inbox drop — close a capture as not worth doing' \
				'  usage: clerk inbox drop <id> [--returned keep|discard]' \
				'  runs: if returned/<id> exists, requires --returned keep|discard; discard deletes' \
				'        that evidence branch, keep preserves it; then bd close <id> --reason wontfix' \
				'        (backlog: bd) / gh issue close <id> (backlog: gh)' \
				"  see:  $ADR16"
			;;
		'inbox pregrill')
			printf '%s\n' \
				'clerk inbox pregrill — append prep notes onto a unit before its grill' \
				'  runs: bd update <id> --notes "<dated, state-neutral prep note>"    (backlog: bd)' \
				'        gh issue comment <id> --body "<prep note>"                   (backlog: gh)' \
				'        note carries open decisions, premises with suggested verifications, draft criteria' \
				"  see:  $ADR16"
			;;
		'backlog next')
			printf '%s\n' \
				'clerk backlog next — pick the next ready unit' \
				'  runs: bd ready --readonly --label stage:ready --json     (backlog: bd)' \
				'        gh issue list --label ready-for-agent              (backlog: gh)' \
				"  see:  $ADR17"
			;;
		'backlog show')
			printf '%s\n' \
				'clerk backlog show — show one backlog unit' \
				'  runs: bd show <id>          (backlog: bd)' \
				'        gh issue view <id>    (backlog: gh)' \
				"  see:  $ADR15"
			;;
		'backlog claim')
			printf '%s\n' \
				'clerk backlog claim — take the claim lock on a unit' \
				'  usage: clerk backlog claim <id> [--from-returned]' \
				'  runs: refuses units with no Acceptance Criteria section (ADR 0016 C4); short-circuits' \
				'        if you already hold it; else git push of the canonical delivery/<id> branch' \
				'        (first push wins — the universal CAS lock, exit 5 if occupied or the race is' \
				'        lost); on success, bd update <id> --claim as the online fast-path record' \
				'        (backlog: bd); offline: local-only branch + claim, attended only; finally' \
				'        git worktree add .worktrees/<id>, printing its absolute path; with' \
				'        --from-returned, replays returned/<id> on top of current main and keeps the' \
				'        returned evidence branch untouched' \
				"  see:  $ADR17"
			;;
		'backlog release')
			printf '%s\n' \
				'clerk backlog release — give a claim back without finishing (unit stays stage:ready)' \
				'  runs: refuses if delivery/<id> carries commits beyond main (prescribes submit or' \
				'        return instead); else git worktree remove + git branch -D delivery/<id>,' \
				'        plus git push origin --delete delivery/<id> when reachable; then' \
				'        bd update <id> --status open --assignee ""        (backlog: bd)' \
				'        gh issue edit <id> --remove-assignee              (backlog: gh)' \
				'        offline: local teardown only, remote delete deferred to sync; job-context refuses;' \
				'        idempotent (exit 0) on a unit not claimed here' \
				"  see:  $ADR15"
			;;
		'backlog submit')
			printf '%s\n' \
				'clerk backlog submit — open the unit'"'"'s PR (once per unit; iteration repeats finish)' \
				'  runs: stamps the unit'"'"'s acceptance criteria into the PR body, runs clerk backlog gate as a local preflight, pushes delivery/<id>, then gh pr create; never arms auto-merge' \
				"  see:  $ADR16"
			;;
		'backlog gate')
			printf '%s\n' \
				'clerk backlog gate — validate delivery proof classes C1-C4' \
				'  runs: C1 branch/link/current protocol checks; C2 PR-body verification schema check; C3 bats tests/clerk plus shellcheck bin/; C4 one evidence line per acceptance criterion' \
				'        local mode: --branch delivery/<id> --body-file <file>; CI mode: reads GITHUB_* and gh pr view' \
				"  see:  $ADR16"
			;;
		'backlog finish')
			printf '%s\n' \
				'clerk backlog finish — reconcile a submitted unit to done' \
				'  runs: gh pr view --json state,mergedAt (merge detected via PR state, never ancestry); closes the unit; tears down the worktree; --watch wraps gh pr checks --watch' \
				"  see:  $ADR15"
			;;
		'backlog return')
			printf '%s\n' \
				'clerk backlog return — send a unit back to discovery (verdict: cannot be fulfilled as designed)' \
				'  runs: requires --reason "<text>"; renames delivery/<id> -> returned/<id> (local; pushes' \
				'        the new ref and deletes delivery/<id> on origin when reachable) so the attempt' \
				'        survives as grill evidence, then git worktree remove; bd update <id> --status open' \
				'        --remove-label stage:ready --assignee ""                (backlog: bd)' \
				'        gh issue reopen <id> + edit --remove-label ready-for-agent --remove-assignee (backlog: gh)' \
				'        then files the reason verbatim as an impediment-typed capture referencing' \
				'        returned/<id>: bd create --type impediment (backlog: bd) / gh issue create' \
				'        --label type:impediment (backlog: gh); offline: local rename only, remote' \
				'        deferred to sync; job-context refuses' \
				"  see:  $ADR16"
			;;
		*)
			unknown_verb "$1"
			;;
	esac
}

# ---------------------------------------------------------- capture + inbox ----
# unit dotfiles-dft.2: `capture` and the six `inbox` verbs. The `.clerk` marker's backend
# (already validated by marker_gate before any of this runs) selects the per-backend branch
# in each cmd_* function below. Contract points C-a..C-g referenced in comments are this
# unit's resolved divergence points (see the unit body / delivery notes for the full list).

# C-e (acceptance-criteria detection, `inbox ready`): presence of a structural section only
# — never a quality judgment, which stays grill's job (ADR 0016 C4). A markdown heading (any
# '#' depth) or a bare "Acceptance Criteria[:]" line counts; prose that merely mentions the
# phrase does not, so a capture whose body says "no acceptance criteria yet" is still refused.
has_acceptance_criteria_section() {
	grep -qiE '^#{1,6}[[:space:]]*acceptance criteria|^acceptance criteria:?[[:space:]]*$' <<<"$1"
}

# C-c (impediment type): bd rejects any --type outside its built-in set unless the type is
# registered via the `types.custom` config key (bd create --help: "custom types require
# types.custom config" — verified empirically: `bd create --type impediment` fails
# "invalid issue type: impediment" against a fresh db). Rather than push a one-time
# repo-setup step onto `clerk doctor` (core, not this unit's to touch), capture
# self-provisions the config idempotently the first time --impediment is used: `bd config
# get` prints the literal sentinel "<key> (not set)" when absent (exit 0, not an error), so
# we normalize that to empty, check whether "impediment" is already one of the
# comma-separated values, and merge it in if not. This makes `capture --impediment` work
# unconditionally, including against a brand-new bd db with zero prior setup — no separate
# fixture step required (the test fixture may still pre-set it; either order works).
bd_ensure_impediment_type() {
	local current
	current=$(bd config get types.custom 2>/dev/null)
	case "$current" in
		*'(not set)'*) current="" ;;
	esac
	local -a values=()
	if [ -n "$current" ]; then
		IFS=',' read -ra values <<<"$current"
	fi
	local v
	for v in "${values[@]+"${values[@]}"}"; do
		[ "$v" = impediment ] && return 0
	done
	if [ -z "$current" ]; then
		bd config set types.custom impediment >/dev/null 2>&1
	else
		bd config set types.custom "$current,impediment" >/dev/null 2>&1
	fi
}

# C-d (pregrill marker: absent|present|stale): derived cheaply from metadata already
# present on every `bd list --json` / `gh issue list --json` row — no extra per-issue fetch.
# A pregrill note carries a full-timestamp tag line ("clerk-pregrill: <ISO-8601>"); present
# iff the issue's updated-at is within a few seconds of that tag (i.e. the pregrill append
# itself was the most recent write — the tolerance absorbs that write's own commit latency,
# empirically a few seconds on slower CI hosts, so a freshly-filed pregrill never reads
# as stale against itself); stale iff updated-at moved meaningfully later, meaning some
# other write landed since; absent iff no tag line exists at all. The other half of C-d's
# staleness definition ("OR its dup-cluster gained members since") is deliberately not
# implemented: computing cluster membership is a `bd find-duplicates` pass, and running
# that on every `inbox list` call is exactly the expense "keep it cheap (metadata only)"
# rules out — dup-driven staleness stays a documented gap, not a silent wrong answer.
PREGRILL_STALE_TOLERANCE_S=10
pregrill_marker() { # $1 = last pregrill-tag timestamp (or ""), $2 = issue updated-at
	local note_ts="$1" upd_ts="$2" note_epoch upd_epoch
	if [ -z "$note_ts" ]; then
		printf 'absent'
		return
	fi
	note_epoch=$(date -u -d "$note_ts" +%s 2>/dev/null) || { printf 'stale'; return; }
	upd_epoch=$(date -u -d "$upd_ts" +%s 2>/dev/null) || { printf 'stale'; return; }
	if [ $((upd_epoch - note_epoch)) -gt "$PREGRILL_STALE_TOLERANCE_S" ]; then
		printf 'stale'
	else
		printf 'present'
	fi
}

# Builds the dated, structured, state-neutral pregrill note body (ADR 0016): open
# decisions, premises each with a suggested verification, draft acceptance criteria. Array
# arguments are passed by name (nameref) since bash cannot pass arrays by value.
build_pregrill_note() { # $1=ts $2=decisions-arrayname $3=premises-arrayname $4=criteria-arrayname
	local -n _decisions="$2" _premises="$3" _criteria="$4"
	local note="clerk-pregrill: $1"
	note+=$'\n'"Open decisions:"
	if [ "${#_decisions[@]}" -eq 0 ]; then
		note+=$'\n'"- (none)"
	else
		local d
		for d in "${_decisions[@]}"; do note+=$'\n'"- $d"; done
	fi
	note+=$'\n'"Premises:"
	if [ "${#_premises[@]}" -eq 0 ]; then
		note+=$'\n'"- (none)"
	else
		local p ptext pverify
		for p in "${_premises[@]}"; do
			case "$p" in
				*'|'*)
					ptext="${p%%|*}"
					pverify="${p#*|}"
					;;
				*)
					ptext="$p"
					pverify="not yet specified"
					;;
			esac
			note+=$'\n'"- $ptext (verify: $pverify)"
		done
	fi
	note+=$'\n'"Draft acceptance criteria:"
	if [ "${#_criteria[@]}" -eq 0 ]; then
		note+=$'\n'"- (none)"
	else
		local c
		for c in "${_criteria[@]}"; do note+=$'\n'"- $c"; done
	fi
	printf '%s' "$note"
}

# clerk capture "<title>" [--stdin|--impediment]
cmd_capture() {
	local backend="$1"
	shift 2
	if [ $# -eq 0 ]; then
		usage_error 'clerk capture: missing title — usage: clerk capture "<title>" [--stdin|--impediment]'
	fi
	local title="$1"
	shift
	local use_stdin=0 use_impediment=0
	while [ $# -gt 0 ]; do
		case "$1" in
			--stdin) use_stdin=1 ;;
			--impediment) use_impediment=1 ;;
			*) usage_error "clerk capture: unknown argument '$1' — usage: clerk capture \"<title>\" [--stdin|--impediment]" ;;
		esac
		shift
	done

	case "$backend" in
		bd)
			[ "$use_impediment" -eq 1 ] && bd_ensure_impediment_type
			local -a args=(bd create "$title" --silent)
			[ "$use_stdin" -eq 1 ] && args+=(--stdin)
			[ "$use_impediment" -eq 1 ] && args+=(--type impediment)
			local id
			if ! id=$("${args[@]}"); then
				backend_fail "capture failed — bd create did not succeed for \"$title\""
			fi
			# mutation self-verify (ADR 0015): confirm the id landed before declaring success
			local seen
			seen=$(bd show "$id" --readonly --json 2>/dev/null | jq -r '.[0].id // empty')
			if [ "$seen" != "$id" ]; then
				backend_fail "capture failed — $id was not confirmed after creation"
			fi
			if [ "$use_impediment" -eq 1 ]; then
				printf '%sclerk:%s filed %s (type: impediment)\n' "$C_GRN" "$C_RST" "$id"
			else
				printf '%sclerk:%s filed %s\n' "$C_GRN" "$C_RST" "$id"
			fi
			;;
		gh)
			local -a args=(gh issue create --title "$title")
			[ "$use_stdin" -eq 1 ] && args+=(--body-file -)
			# gh has no first-class issue "type" reachable from `issue create`; a label is
			# this backend's closest analogue to bd's `--type impediment` (documented choice).
			[ "$use_impediment" -eq 1 ] && args+=(--label type:impediment)
			local url
			if ! url=$("${args[@]}"); then
				backend_fail "capture failed — gh issue create did not succeed for \"$title\""
			fi
			if [ "$use_impediment" -eq 1 ]; then
				printf '%sclerk:%s filed %s (type: impediment)\n' "$C_GRN" "$C_RST" "$url"
			else
				printf '%sclerk:%s filed %s\n' "$C_GRN" "$C_RST" "$url"
			fi
			;;
	esac
}

# clerk inbox list — the pool is OPEN minus stage:ready (ADR 0015: the definition moves
# from presort prose into this code), plus the per-unit pregrill marker (C-d).
cmd_inbox_list() {
	local backend="$1"
	shift 2
	case "$backend" in
		bd)
			# stdout only: stderr is left to flow straight to the terminal (bd's own error
			# text lands there on failure) rather than being folded into $json, which must
			# stay pure JSON on success — a stray warning on stderr would otherwise corrupt
			# the jq parse below.
			local json
			if ! json=$(bd list --status open --exclude-label stage:ready --readonly --json); then
				backend_fail "inbox list failed — bd list did not succeed"
			fi
			local count
			count=$(printf '%s' "$json" | jq 'length')
			printf 'Inbox (open, not ready) — %s item(s):\n' "$count"
			if [ "$count" -eq 0 ]; then
				printf '  (empty)\n'
				return 0
			fi
			# Field separator is \x1f (ASCII unit separator), NOT a tab: bash's `read` always
			# collapses runs of IFS *whitespace* characters (space/tab/newline) and trims
			# them at the edges, even when IFS is set to just one of them — so a genuinely
			# empty middle field (the common case here: no pregrill tag yet) silently merges
			# with its neighbour and shifts every later field left. \x1f is not whitespace,
			# so empty fields survive intact.
			local id title note_ts upd_ts marker
			while IFS=$'\x1f' read -r id title note_ts upd_ts; do
				marker=$(pregrill_marker "$note_ts" "$upd_ts")
				printf '  %s  [pregrill:%s]  %s\n' "$id" "$marker" "$title"
			done < <(printf '%s' "$json" | jq -r '
				def pregrill_ts: (.notes // "")
					| [scan("clerk-pregrill: ([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)")] as $m
					| if ($m|length)==0 then "" else $m[-1][0] end;
				.[] | [.id, .title, pregrill_ts, (.updated_at // "")] | join("\u001f")')
			;;
		gh)
			local json
			if ! json=$(gh issue list --state open --json number,title,labels,updatedAt,comments); then
				backend_fail "inbox list failed — gh issue list did not succeed"
			fi
			json=$(printf '%s' "$json" | jq -c '[.[] | select((.labels | map(.name) | index("ready-for-agent")) == null)]')
			local count
			count=$(printf '%s' "$json" | jq 'length')
			printf 'Inbox (open, not ready) — %s item(s):\n' "$count"
			if [ "$count" -eq 0 ]; then
				printf '  (empty)\n'
				return 0
			fi
			local num title note_ts upd_ts marker
			while IFS=$'\x1f' read -r num title note_ts upd_ts; do
				marker=$(pregrill_marker "$note_ts" "$upd_ts")
				printf '  #%s  [pregrill:%s]  %s\n' "$num" "$marker" "$title"
			done < <(printf '%s' "$json" | jq -r '
				def pregrill_ts: ([.comments[]?.body] | join("\n")) as $all
					| [$all | scan("clerk-pregrill: ([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)")] as $m
					| if ($m|length)==0 then "" else $m[-1][0] end;
				.[] | [.number, .title, pregrill_ts, (.updatedAt // "")] | join("\u001f")')
			;;
	esac
}

# clerk inbox show <id>
cmd_inbox_show() {
	local backend="$1"
	shift 2
	local id="${1:-}"
	if [ -z "$id" ]; then
		usage_error 'clerk inbox show: missing id — usage: clerk inbox show <id>'
	fi
	case "$backend" in
		bd) bd show "$id" --readonly ;;
		gh) gh issue view "$id" ;;
	esac
}

# clerk inbox dups — cross-pool by design: a capture duplicating an already-ready bead is
# a real duplicate, so this never pre-filters to the inbox pool (unlike `inbox list`).
cmd_inbox_dups() {
	local backend="$1"
	shift 2
	case "$backend" in
		bd)
			local json
			if ! json=$(bd find-duplicates --readonly --json); then
				backend_fail "inbox dups failed — bd find-duplicates did not succeed"
			fi
			local count
			count=$(printf '%s' "$json" | jq -r '.count // 0')
			printf 'Duplicate candidates — %s pair(s):\n' "$count"
			if [ "$count" -eq 0 ]; then
				printf '  (none)\n'
				return 0
			fi
			printf '%s' "$json" | jq -r '.pairs[] | "  \(.issue_a_id) \"\(.issue_a_title)\"  ~  \(.issue_b_id) \"\(.issue_b_title)\"  (score: \(.similarity))"'
			;;
		gh)
			# Documented stub (the unit spec explicitly allows this): gh has no
			# `find-duplicates` analogue, and bd is this repo's real backend. A genuine
			# text-similarity pass over `gh issue list` is deferred until a gh-backed repo
			# actually needs it.
			printf 'clerk: inbox dups (gh backend): not implemented — no similarity pass yet; see ADR 0016\n'
			;;
	esac
}

returned_short_from_id() { # $1=id; echoes the token used by returned/<short>
	local id="$1"
	id="${id#\#}"
	case "$id" in
		*-*) printf '%s\n' "${id#*-}" ;;
		*) printf '%s\n' "$id" ;;
	esac
}

returned_branch_exists() { # $1=root $2=short
	local main_root short
	main_root=$(primary_repo_root "$1")
	short="$2"
	git -C "$main_root" show-ref --verify --quiet "refs/heads/returned/$short" && return 0
	git -C "$main_root" show-ref --verify --quiet "refs/remotes/origin/returned/$short" && return 0
	return 1
}

dispose_returned() { # $1=root $2=short
	local main_root short local_refs remote_refs offline=0 ref branch
	main_root=$(primary_repo_root "$1")
	short="$2"
	local_refs=$(git -C "$main_root" for-each-ref --format='%(refname:short)' \
		"refs/heads/returned/$short" "refs/heads/returned/$short-*" 2>/dev/null || true)
	remote_refs=$(git -C "$main_root" for-each-ref --format='%(refname:short)' \
		"refs/remotes/origin/returned/$short" "refs/remotes/origin/returned/$short-*" 2>/dev/null || true)
	if [ -z "$local_refs" ] && [ -z "$remote_refs" ]; then
		return 0
	fi
	while IFS= read -r ref; do
		[ -n "$ref" ] || continue
		git -C "$main_root" branch -D "$ref" >/dev/null 2>&1 ||
			backend_fail "returned disposition failed — could not delete local $ref"
	done <<<"$local_refs"
	if ! (GIT_TERMINAL_PROMPT=0 timeout 10 git -C "$main_root" fetch origin >/dev/null 2>&1); then
		offline=1
	fi
	if [ "$offline" -eq 1 ]; then
		printf 'clerk: OFFLINE - returned/%s and archives deleted locally only; the remote branch delete is deferred to sync (clerk sync will finish it at the next reconnect).\n' "$short" >&2
		return 0
	fi
	remote_refs=$(git -C "$main_root" for-each-ref --format='%(refname:short)' \
		"refs/remotes/origin/returned/$short" "refs/remotes/origin/returned/$short-*" 2>/dev/null || true)
	while IFS= read -r ref; do
		[ -n "$ref" ] || continue
		branch="${ref#origin/}"
		git -C "$main_root" push origin --delete "$branch" >/dev/null 2>&1 ||
			backend_fail "returned disposition failed — could not delete origin $branch"
		git -C "$main_root" update-ref -d "refs/remotes/origin/$branch" >/dev/null 2>&1 || true
	done <<<"$remote_refs"
}

handle_returned_disposition() { # $1=verb-label $2=root $3=short $4=keep|discard|empty
	local verb="$1" root="$2" short="$3" disposition="$4"
	case "$disposition" in
		"" )
			if returned_branch_exists "$root" "$short"; then
				usage_error "clerk $verb: returned/$short exists — choose --returned keep or --returned discard"
			fi
			;;
		keep) ;;
		discard) dispose_returned "$root" "$short" ;;
		*) usage_error "clerk $verb: --returned must be keep or discard" ;;
	esac
}

# clerk inbox ready <id> [--design-file <file>] [--acceptance-file <file>] [--returned keep|discard]
# gh: clerk inbox ready <id> --title "<title>" --body-file <file>
cmd_inbox_ready() {
	local backend="$1" root="$2"
	shift 2
	if [ $# -eq 0 ]; then
		usage_error 'clerk inbox ready: missing id — usage: clerk inbox ready <id> [--design-file <path>] [--acceptance-file <path>]'
	fi
	local id="$1"
	shift
	local title="" body_file="" design_file="" acceptance_file="" returned_disposition=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--title)
				[ $# -ge 2 ] || usage_error "clerk inbox ready: --title needs a value"
				title="$2"
				shift
				;;
			--body-file)
				[ $# -ge 2 ] || usage_error "clerk inbox ready: --body-file needs a value"
				body_file="$2"
				shift
				;;
			--design-file)
				[ $# -ge 2 ] || usage_error "clerk inbox ready: --design-file needs a path"
				design_file="$2"
				shift
				;;
			--acceptance-file)
				[ $# -ge 2 ] || usage_error "clerk inbox ready: --acceptance-file needs a path"
				acceptance_file="$2"
				shift
				;;
			--returned)
				[ $# -ge 2 ] || usage_error "clerk inbox ready: --returned needs keep or discard"
				returned_disposition="$2"
				shift
				;;
			*) usage_error "clerk inbox ready: unknown argument '$1'" ;;
		esac
		shift
	done

	case "$backend" in
		bd)
			[ -z "$title" ] || usage_error 'clerk inbox ready: --title is only for gh-backed promotion; use --design-file/--acceptance-file for bd'
			[ -z "$body_file" ] || usage_error 'clerk inbox ready: --body-file is only for gh-backed promotion; use --design-file/--acceptance-file for bd'
			[ -z "$design_file" ] || [ -f "$design_file" ] || usage_error "clerk inbox ready: design file not found: $design_file"
			[ -z "$acceptance_file" ] || [ -f "$acceptance_file" ] || usage_error "clerk inbox ready: acceptance file not found: $acceptance_file"
			local json
			json=$(bd show "$id" --readonly --json 2>/dev/null)
			# bd 1.0.4 signals a missing id not with empty stdout or literal `null` but with
			# an ERROR OBJECT on stdout (`{"error":"no issues found...","schema_version":1}`,
			# nonzero exit — discarded by `$(...)`). A successful lookup is always a non-empty
			# JSON array. So "not an array, or an empty one" is the not-found test; checking
			# for the object shape directly (rather than relying on the later jq calls to fail
			# into empty strings) keeps this guard accurate instead of accidental.
			if [ -z "$json" ] || [ "$json" = null ] ||
				! printf '%s' "$json" | jq -e 'if type != "array" then false else (length > 0) end' >/dev/null 2>&1; then
				usage_error "clerk inbox ready: $id not found — check the id ('clerk inbox list' shows open units)"
			fi
			local short
			short=$(returned_short_from_id "$id")
			handle_returned_disposition 'inbox ready' "$root" "$short" "$returned_disposition"
			# C-e also covers bd's first-class `acceptance_criteria` field (populated by
			# `bd create --acceptance`/`--acceptance-file`), not just prose in description or
			# design: that dedicated field IS the structural section by construction, so its
			# mere non-empty presence satisfies C-e without re-scanning it for a heading.
			local desc design ac acceptance_text="" design_text=""
			if [ -n "$design_file" ] || [ -n "$acceptance_file" ]; then
				local -a update_args=(bd update "$id")
				if [ -n "$design_file" ]; then
					design_text=$(cat "$design_file")
					update_args+=(--design-file "$design_file")
				fi
				if [ -n "$acceptance_file" ]; then
					acceptance_text=$(cat "$acceptance_file")
					update_args+=(--acceptance "$acceptance_text")
				fi
				if ! "${update_args[@]}" >/dev/null; then
					backend_fail "inbox ready failed — bd update did not succeed for $id"
				fi
				json=$(bd show "$id" --readonly --json 2>/dev/null)
				if [ -n "$design_file" ] && [ "$(printf '%s' "$json" | jq -r '.[0].design // ""')" != "$design_text" ]; then
					backend_fail "inbox ready failed — design was not confirmed after writing $design_file"
				fi
				if [ -n "$acceptance_file" ] && [ "$(printf '%s' "$json" | jq -r '.[0].acceptance_criteria // ""')" != "$acceptance_text" ]; then
					backend_fail "inbox ready failed — acceptance criteria were not confirmed after writing $acceptance_file"
				fi
			fi
			desc=$(printf '%s' "$json" | jq -r '.[0].description // ""')
			design=$(printf '%s' "$json" | jq -r '.[0].design // ""')
			ac=$(printf '%s' "$json" | jq -r '.[0].acceptance_criteria // ""')
			if [ -z "$ac" ] && ! has_acceptance_criteria_section "$desc"$'\n'"$design"; then
				usage_error "clerk inbox ready: $id has no 'Acceptance Criteria' section — rerun with --acceptance-file <path> (and optionally --design-file <path>) before promoting it"
			fi
			if ! bd update "$id" --add-label stage:ready >/dev/null; then
				backend_fail "inbox ready failed — bd update did not succeed for $id"
			fi
			# mutation self-verify (ADR 0015)
			local has_label
			has_label=$(bd show "$id" --readonly --json 2>/dev/null | jq -r '(.[0].labels // []) | index("stage:ready")')
			if [ "$has_label" = null ]; then
				backend_fail "inbox ready failed — $id was not confirmed stage:ready after promotion"
			fi
			printf '%sclerk:%s promoted %s to stage:ready\n' "$C_GRN" "$C_RST" "$id"
			;;
		gh)
			[ -z "$design_file" ] || usage_error 'clerk inbox ready: --design-file is only for bd-backed promotion; use --title/--body-file for gh'
			[ -z "$acceptance_file" ] || usage_error 'clerk inbox ready: --acceptance-file is only for bd-backed promotion; use --title/--body-file for gh'
			[ -z "$returned_disposition" ] || usage_error 'clerk inbox ready: --returned is only implemented for bd-backed returned branches'
			if [ -z "$title" ] || [ -z "$body_file" ]; then
				usage_error "clerk inbox ready: gh backend needs both --title \"<title>\" and --body-file <file> — rerun as 'clerk inbox ready $id --title \"<title>\" --body-file <file>'"
			fi
			local url
			if ! url=$(gh issue create --title "$title" --body-file "$body_file"); then
				backend_fail "inbox ready failed — gh issue create did not succeed"
			fi
			local num="${url##*/}"
			# create, THEN close the capture referencing it — in that order (spec-mandated).
			if ! gh issue close "$id" --comment "promoted: #$num" >/dev/null; then
				backend_fail "inbox ready failed — gh issue close did not succeed for $id"
			fi
			printf '%sclerk:%s promoted %s to #%s (%s)\n' "$C_GRN" "$C_RST" "$id" "$num" "$url"
			;;
	esac
}

# clerk inbox drop <id>
cmd_inbox_drop() {
	local backend="$1" root="$2"
	shift 2
	local id="${1:-}"
	if [ -z "$id" ]; then
		usage_error 'clerk inbox drop: missing id — usage: clerk inbox drop <id> [--returned keep|discard]'
	fi
	shift
	local returned_disposition=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--returned)
				[ $# -ge 2 ] || usage_error "clerk inbox drop: --returned needs keep or discard"
				returned_disposition="$2"
				shift
				;;
			*) usage_error "clerk inbox drop: unknown argument '$1'" ;;
		esac
		shift
	done
	case "$backend" in
		bd)
			local short
			short=$(returned_short_from_id "$id")
			handle_returned_disposition 'inbox drop' "$root" "$short" "$returned_disposition"
			if ! bd close "$id" --reason wontfix >/dev/null; then
				backend_fail "inbox drop failed — bd close did not succeed for $id"
			fi
			local status
			status=$(bd show "$id" --readonly --json 2>/dev/null | jq -r '.[0].status // ""')
			if [ "$status" != closed ]; then
				backend_fail "inbox drop failed — $id was not confirmed closed"
			fi
			printf '%sclerk:%s dropped %s (wontfix)\n' "$C_GRN" "$C_RST" "$id"
			;;
		gh)
			[ -z "$returned_disposition" ] || usage_error 'clerk inbox drop: --returned is only implemented for bd-backed returned branches'
			if ! gh issue close "$id" >/dev/null; then
				backend_fail "inbox drop failed — gh issue close did not succeed for $id"
			fi
			printf '%sclerk:%s dropped %s\n' "$C_GRN" "$C_RST" "$id"
			;;
	esac
}

# clerk inbox pregrill <id> [--decision "<text>"]... [--premise "<text>|<verify>"]... [--criterion "<text>"]...
# The SINGLE write verb of the inbox (ADR 0016 ruling 20): bd's only mutation is
# --append-notes (C-b) and the result is self-verified state-neutral (status/labels
# byte-identical before/after) before success is reported (ADR 0015 mutation self-verify).
cmd_inbox_pregrill() {
	local backend="$1"
	shift 2
	if [ $# -eq 0 ]; then
		usage_error 'clerk inbox pregrill: missing id — usage: clerk inbox pregrill <id> [--decision "<text>"]... [--premise "<text>|<verification>"]... [--criterion "<text>"]...'
	fi
	local id="$1"
	shift
	local -a decisions=() premises=() criteria=()
	while [ $# -gt 0 ]; do
		case "$1" in
			--decision)
				[ $# -ge 2 ] || usage_error "clerk inbox pregrill: --decision needs a value"
				decisions+=("$2")
				shift
				;;
			--premise)
				[ $# -ge 2 ] || usage_error "clerk inbox pregrill: --premise needs a value"
				premises+=("$2")
				shift
				;;
			--criterion)
				[ $# -ge 2 ] || usage_error "clerk inbox pregrill: --criterion needs a value"
				criteria+=("$2")
				shift
				;;
			*) usage_error "clerk inbox pregrill: unknown argument '$1'" ;;
		esac
		shift
	done

	local ts note
	ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
	note=$(build_pregrill_note "$ts" decisions premises criteria)

	case "$backend" in
		bd)
			local before after
			before=$(bd show "$id" --readonly --json 2>/dev/null | jq -c '.[0] | {status, labels}' 2>/dev/null)
			if [ -z "$before" ] || [ "$before" = null ]; then
				usage_error "clerk inbox pregrill: $id not found — check the id ('clerk inbox list' shows open units)"
			fi
			if ! bd update "$id" --append-notes "$note" >/dev/null; then
				backend_fail "inbox pregrill failed — bd update --append-notes did not succeed for $id"
			fi
			after=$(bd show "$id" --readonly --json 2>/dev/null | jq -c '.[0] | {status, labels}' 2>/dev/null)
			if [ "$before" != "$after" ]; then
				backend_fail "inbox pregrill failed — $id status/labels changed (not state-neutral)"
			fi
			printf '%sclerk:%s pregrilled %s (dated %s)\n' "$C_GRN" "$C_RST" "$id" "$ts"
			;;
		gh)
			if ! gh issue comment "$id" --body "$note" >/dev/null; then
				backend_fail "inbox pregrill failed — gh issue comment did not succeed for $id"
			fi
			printf '%sclerk:%s pregrilled %s (dated %s)\n' "$C_GRN" "$C_RST" "$id" "$ts"
			;;
	esac
}

# ------------------------------------------------------------------ backlog ----
# unit dotfiles-dft.3: `backlog next` + `backlog show` — read-only windows onto the ready
# pool, invoked with the backend's read-only mode so a harness allowlisting reads-only can
# safely run either verb. Mirrors `inbox list`/`inbox show`'s shape (dft.2): backlog's ready
# pool is `bd ready` (blocker-aware) narrowed to the `stage:ready` label — the ADR 0016
# definition of ready — rather than `bd list --label stage:ready`, so a labeled-but-blocked
# unit never surfaces as pickable.

# clerk backlog next — the ready pool: bd's blocker-aware `ready` set narrowed to
# stage:ready (ADR 0016); gh's ready-for-agent label is the near-passthrough analogue.
cmd_backlog_next() {
	local backend="$1"
	shift 2
	case "$backend" in
		bd)
			local json
			if ! json=$(bd ready --readonly --label stage:ready --json); then
				backend_fail "backlog next failed — bd ready did not succeed"
			fi
			local count
			count=$(printf '%s' "$json" | jq 'length')
			printf 'Backlog (ready) — %s item(s):\n' "$count"
			if [ "$count" -eq 0 ]; then
				printf '  (empty)\n'
				return 0
			fi
			printf '%s' "$json" | jq -r '.[] | "  \(.id)  \(.title)"'
			;;
		gh)
			local json
			if ! json=$(gh issue list --label ready-for-agent --json number,title); then
				backend_fail "backlog next failed — gh issue list did not succeed"
			fi
			local count
			count=$(printf '%s' "$json" | jq 'length')
			printf 'Backlog (ready) — %s item(s):\n' "$count"
			if [ "$count" -eq 0 ]; then
				printf '  (empty)\n'
				return 0
			fi
			printf '%s' "$json" | jq -r '.[] | "  #\(.number)  \(.title)"'
			;;
	esac
}

# clerk backlog show <id>
cmd_backlog_show() {
	local backend="$1"
	shift 2
	local id="${1:-}"
	if [ -z "$id" ]; then
		usage_error 'clerk backlog show: missing id — usage: clerk backlog show <id>'
	fi
	case "$backend" in
		bd) bd show "$id" --readonly ;;
		gh) gh issue view "$id" ;;
	esac
}

# unit dotfiles-dft.3: `backlog claim` — provisions the workspace for a ready unit. Resolves
# the caller's id (short or full) to the project's canonical short token, gates on acceptance
# criteria (C4, reusing dft.2's structural detector), short-circuits an idempotent re-claim,
# then uses a first-push-wins git branch (`delivery/<short>`) as the universal CAS lock before
# recording the claim on the backend (`bd update --claim`) and provisioning
# `.worktrees/<short>`. Exit 5 here means CLAIM CONFLICT (unit occupied, or the push-CAS race
# was lost) — distinct from backend_fail's exit 5 (an outright backend failure) — so it is
# never routed through backend_fail, which would wrongly tell the caller to run `clerk doctor`
# over a normal contention outcome.

# The identity bd's own `--claim` records as assignee absent an explicit --actor (bd's actor
# resolution order per `bd update --help`: $BEADS_ACTOR, git user.name, $USER) — mirrored here
# so re-claim / holder comparisons need no extra bd round-trip.
claim_current_actor() { # $1=root
	if [ -n "${BEADS_ACTOR:-}" ]; then
		printf '%s\n' "$BEADS_ACTOR"
		return 0
	fi
	local name
	name=$(git -C "$1" config user.name 2>/dev/null)
	if [ -n "$name" ]; then
		printf '%s\n' "$name"
	else
		printf '%s\n' "${USER:-}"
	fi
}

claim_current_gh_login() {
	gh api user --jq .login 2>/dev/null
}

# JOB-CONTEXT: env CLERK_JOB non-empty, or CI truthy (anything but unset/empty/a falsy word).
claim_in_job_context() {
	[ -n "${CLERK_JOB:-}" ] && return 0
	case "${CI:-}" in
		'' | 0 | false | False | FALSE | no | No | NO) return 1 ;;
		*) return 0 ;;
	esac
}

# Resolves $2 (a bd/gh id, short or full — either form is accepted, ADR 0017) against backend
# $1. On success sets CLAIM_SHORT/CLAIM_FULL/CLAIM_TITLE/CLAIM_HOLDER/CLAIM_STATUS/
# CLAIM_DESC/CLAIM_DESIGN/CLAIM_AC and returns 0; on not-found returns 1 and leaves those
# cleared. Never exits — the caller owns the refusal (usage_error), so this stays safe to call
# directly (no subshell-swallowed exit).
claim_resolve_id() {
	local backend="$1" id_arg="$2"
	CLAIM_SHORT="" CLAIM_FULL="" CLAIM_TITLE="" CLAIM_HOLDER="" CLAIM_STATUS="" CLAIM_DESC="" CLAIM_DESIGN="" CLAIM_AC=""
	case "$backend" in
		bd)
			local json
			json=$(bd show "$id_arg" --readonly --json 2>/dev/null)
			# Same not-found shape `inbox ready` guards against (C-e sibling check): bd 1.0.4
			# signals a missing id with an error OBJECT on stdout, not empty output or `null`.
			if [ -z "$json" ] || [ "$json" = null ] ||
				! printf '%s' "$json" | jq -e 'if type != "array" then false else (length > 0) end' >/dev/null 2>&1; then
				return 1
			fi
			CLAIM_FULL=$(printf '%s' "$json" | jq -r '.[0].id')
			CLAIM_SHORT="${CLAIM_FULL#*-}"
			CLAIM_TITLE=$(printf '%s' "$json" | jq -r '.[0].title // .[0].id')
			CLAIM_STATUS=$(printf '%s' "$json" | jq -r '.[0].status // ""')
			CLAIM_DESC=$(printf '%s' "$json" | jq -r '.[0].description // ""')
			CLAIM_DESIGN=$(printf '%s' "$json" | jq -r '.[0].design // ""')
			CLAIM_AC=$(printf '%s' "$json" | jq -r '.[0].acceptance_criteria // ""')
			CLAIM_HOLDER=$(printf '%s' "$json" | jq -r '.[0].assignee // .[0].owner // ""')
			;;
		gh)
			local json
			json=$(gh issue view "$id_arg" --json number,title,body,assignees 2>/dev/null) || return 1
			CLAIM_FULL=$(printf '%s' "$json" | jq -r '.number')
			CLAIM_SHORT="$CLAIM_FULL"
			CLAIM_TITLE=$(printf '%s' "$json" | jq -r '.title // (.number | tostring)')
			CLAIM_STATUS=$(printf '%s' "$json" | jq -r '.state // ""')
			CLAIM_DESC=$(printf '%s' "$json" | jq -r '.body // ""')
			CLAIM_HOLDER=$(printf '%s' "$json" | jq -r '.assignees[0].login // ""')
			;;
	esac
	[ -n "$CLAIM_SHORT" ] || return 1
	return 0
}

# Ensures .worktrees/<short> exists off local branch delivery/<short>, echoing its absolute
# path on success and returning 1 (never exiting — see the command-substitution note on
# claim_resolve_id) on failure. `worktree prune` first: a worktree directory removed by hand
# (`rm -rf` instead of `git worktree remove`) leaves git believing it is still checked out
# there, so a bare `add` would otherwise refuse with "missing but already registered".
claim_ensure_worktree() { # $1=root $2=short
	local root="$1" short="$2"
	local wt="$root/.worktrees/$short"
	if [ -d "$wt" ]; then
		printf '%s\n' "$wt"
		return 0
	fi
	git -C "$root" worktree prune >/dev/null 2>&1
	if git -C "$root" worktree add "$wt" "delivery/$short" >/dev/null 2>&1; then
		printf '%s\n' "$wt"
		return 0
	fi
	# Local branch missing (rare — e.g. bd still shows the claim as yours but the branch was
	# lost) — fall back to a remote copy if the sync-check step found one.
	if git -C "$root" show-ref --verify --quiet "refs/remotes/origin/delivery/$short" &&
		git -C "$root" worktree add -b "delivery/$short" "$wt" "origin/delivery/$short" >/dev/null 2>&1; then
		printf '%s\n' "$wt"
		return 0
	fi
	return 1
}

# CLAIM CONFLICT (exit 5): unit occupied, or the push-CAS race was lost. Its own prescriptive
# text (never backend_fail's "run clerk doctor" — the backend is not broken, someone else just
# got there first).
claim_conflict() { # $1=short $2=holder $3=reason-phrase, e.g. "is already claimed"/"was just claimed"
	local short="$1" holder="${2:-someone else}" reason="$3"
	printf 'clerk: backlog claim refused — delivery/%s %s by %s\n' "$short" "$reason" "$holder" >&2
	printf "       wait for %s to release or finish it, or pick a different unit ('clerk backlog next')\n" "$holder" >&2
	exit 5
}

# bd's online/offline claim record: `--claim` (atomic, idempotent-if-yours), then a mutation
# self-verify (ADR 0015) before letting the caller report success.
claim_record_bd() { # $1=root $2=full-id
	local root="$1" full="$2"
	bd update "$full" --claim >/dev/null 2>&1 || return 1
	local check
	check=$(bd show "$full" --readonly --json 2>/dev/null | jq -r '.[0].assignee // .[0].owner // ""')
	[ "$check" = "$(claim_current_actor "$root")" ]
}

claim_returned_ref() { # $1=root $2=short; echoes local/remote canonical returned ref
	local root="$1" short="$2"
	if git -C "$root" show-ref --verify --quiet "refs/heads/returned/$short"; then
		printf 'returned/%s\n' "$short"
		return 0
	fi
	if git -C "$root" show-ref --verify --quiet "refs/remotes/origin/returned/$short"; then
		printf 'origin/returned/%s\n' "$short"
		return 0
	fi
	return 1
}

claim_replay_returned() { # $1=root $2=worktree $3=short $4=base-sha
	local root="$1" wt="$2" short="$3" base_sha="$4" ref conflicts
	if ! ref=$(claim_returned_ref "$root" "$short"); then
		usage_error "clerk backlog claim: --from-returned requested but returned/$short was not found"
	fi
	if [ -z "$(git -C "$wt" rev-list --reverse "$base_sha..$ref" 2>/dev/null)" ]; then
		return 0
	fi
	if git -C "$wt" cherry-pick "$base_sha..$ref" >/dev/null 2>&1; then
		return 0
	fi
	conflicts=$(git -C "$wt" diff --name-only --diff-filter=U 2>/dev/null | paste -sd ' ' -)
	printf 'clerk: claim --from-returned hit conflicts while replaying returned/%s onto delivery/%s\n' "$short" "$short" >&2
	printf '       resolve in %s, run git cherry-pick --continue, then clerk backlog submit; conflicted paths: %s\n' "$wt" "${conflicts:-unknown}" >&2
	return 2
}

# clerk backlog claim <id> [--from-returned]
cmd_backlog_claim() {
	local backend="$1" root="$2"
	shift 2
	if [ $# -eq 0 ]; then
		usage_error 'clerk backlog claim: missing id — usage: clerk backlog claim <id>'
	fi
	local id_arg="$1" from_returned=0
	shift
	while [ $# -gt 0 ]; do
		case "$1" in
			--from-returned) from_returned=1 ;;
			*) usage_error "clerk backlog claim: unknown argument '$1' — usage: clerk backlog claim <id> [--from-returned]" ;;
		esac
		shift
	done

	# 1. Resolve to the canonical short id -----------------------------------------
	if ! claim_resolve_id "$backend" "$id_arg"; then
		usage_error "clerk backlog claim: $id_arg not found — check the id ('clerk backlog next' shows ready units)"
	fi
	local short="$CLAIM_SHORT" full="$CLAIM_FULL" holder="$CLAIM_HOLDER"

	# 2. C4 GATE (ADR 0016): presence-only structural check — never a quality judgment.
	if [ -z "$CLAIM_AC" ] && ! has_acceptance_criteria_section "$CLAIM_DESC"$'\n'"$CLAIM_DESIGN"; then
		usage_error "clerk backlog claim: $full has no 'Acceptance Criteria' section — it needs a grill pass first (e.g. 'clerk inbox pregrill $full', then add the section) before it can be claimed"
	fi

	# 3. RE-CLAIM short-circuit: backend assignee already you, or a local branch you hold —
	# no network touched, so this works offline too.
	local me=""
	case "$backend" in
		bd) me=$(claim_current_actor "$root") ;;
		gh) me=$(claim_current_gh_login) ;;
	esac
	local mine=0
	if [ -n "$holder" ] && [ -n "$me" ] && [ "$holder" = "$me" ]; then
		mine=1
	fi
	if git -C "$root" show-ref --verify --quiet "refs/heads/delivery/$short"; then
		mine=1
	fi
	if [ "$mine" -eq 1 ]; then
		local wt
		if ! wt=$(claim_ensure_worktree "$root" "$short"); then
			backend_fail "claim failed — could not provision the worktree at $root/.worktrees/$short for delivery/$short"
		fi
		printf '%sclerk:%s %s already claimed by you — worktree ready\n' "$C_GRN" "$C_RST" "$full"
		printf '%s\n' "$wt"
		return 0
	fi

	# 4. SYNC-CHECK: `git fetch origin`'s failure (bounded by a short timeout, so an
	# unreachable remote refuses promptly instead of hanging the claim) is the OFFLINE signal.
	local offline=0 base_sha=""
	if ! (GIT_TERMINAL_PROMPT=0 timeout 10 git -C "$root" fetch origin >/dev/null 2>&1); then
		offline=1
	fi

	if [ "$from_returned" -eq 1 ] && ! claim_returned_ref "$root" "$short" >/dev/null; then
		usage_error "clerk backlog claim: --from-returned requested but returned/$short was not found"
	fi

	if [ "$offline" -eq 1 ]; then
		if claim_in_job_context; then
			printf "clerk: OFFLINE in a job context - refusing %s: the claim lock needs the remote and no attendant can accept the staleness hazard. Retry when origin is reachable.\n" "$short" >&2
			return 2
		fi
		# ATTENDED: proceed locally-only — the branch is the lock, CAS'd at first reconnect.
		if ! git -C "$root" show-ref --verify --quiet refs/heads/main; then
			backend_fail "claim failed — no local 'main' branch to base delivery/$short on"
		fi
		base_sha=$(git -C "$root" rev-parse main 2>/dev/null) ||
			backend_fail "claim failed — could not resolve local main for delivery/$short"
		if ! git -C "$root" branch "delivery/$short" main 2>/dev/null; then
			backend_fail "claim failed — could not create local branch delivery/$short from main"
		fi
		if [ "$backend" = bd ] && ! claim_record_bd "$root" "$full"; then
			backend_fail "claim failed — delivery/$short was created locally but the bd claim did not confirm for $full"
		fi
		local wt
		if ! wt=$(claim_ensure_worktree "$root" "$short"); then
			backend_fail "claim failed — could not provision the worktree at $root/.worktrees/$short for delivery/$short"
		fi
		if [ "$from_returned" -eq 1 ]; then
			claim_replay_returned "$root" "$wt" "$short" "$base_sha" || return $?
		fi
		printf "clerk: OFFLINE - 'delivery/%s' claimed LOCALLY ONLY (not pushed). The branch is the lock; it is compare-and-swapped at first reconnect (clerk submit/sync). If another machine claimed %s meanwhile, that push wins and this local work is discarded. Proceeding, attended.\n" "$short" "$short" >&2
		printf '%s\n' "$wt"
		return 0
	fi

	# ONLINE: occupied? (holder was already read fresh in step 1, before any of this ran)
	if git -C "$root" show-ref --verify --quiet "refs/remotes/origin/delivery/$short"; then
		claim_conflict "$short" "$holder" 'is already claimed'
	fi

	# 5. PUSH = the universal CAS lock (first-push-wins). Pushed from a raw SHA, not a local
	# branch, so a lost race leaves nothing local to clean up (no orphan worktree/claim).
	base_sha=$(git -C "$root" rev-parse origin/main 2>/dev/null) || base_sha=$(git -C "$root" rev-parse main 2>/dev/null)
	if [ -z "$base_sha" ]; then
		backend_fail "claim failed — could not resolve a base commit (origin/main or main) for delivery/$short"
	fi
	if ! git -C "$root" push origin "$base_sha:refs/heads/delivery/$short" 2>/dev/null; then
		git -C "$root" fetch origin >/dev/null 2>&1
		claim_conflict "$short" "$holder" 'was just claimed'
	fi

	# 6+7. Record the win locally (branch), then on the backend, then provision the worktree.
	if ! git -C "$root" branch "delivery/$short" "$base_sha" 2>/dev/null; then
		backend_fail "claim failed — delivery/$short is pushed but the local branch could not be created"
	fi
	git -C "$root" branch --set-upstream-to="origin/delivery/$short" "delivery/$short" >/dev/null 2>&1 || true

	case "$backend" in
		bd)
			if ! claim_record_bd "$root" "$full"; then
				backend_fail "claim failed — delivery/$short is pushed but the bd claim did not confirm for $full"
			fi
			;;
		gh)
			local login
			login=$(claim_current_gh_login)
			[ -n "$login" ] && gh issue edit "$full" --add-assignee "$login" >/dev/null 2>&1
			;;
	esac

	local wt
	if ! wt=$(claim_ensure_worktree "$root" "$short"); then
		backend_fail "claim failed — could not provision the worktree at $root/.worktrees/$short for delivery/$short"
	fi
	if [ "$from_returned" -eq 1 ]; then
		claim_replay_returned "$root" "$wt" "$short" "$base_sha" || return $?
	fi

	# 8. Print the absolute worktree path as the LAST stdout line.
	printf '%sclerk:%s claimed %s — delivery/%s pushed, worktree ready\n' "$C_GRN" "$C_RST" "$full" "$short"
	printf '%s\n' "$wt"
	return 0
}

# unit dotfiles-dft.3 (this group): `backlog release` and `backlog return` — the two ways to
# give a claim back. `release` is the no-verdict path (unit stays exactly as ready as it
# was); `return` is the verdict path (the unit could not be fulfilled as designed, so it goes
# back to discovery with a mandatory, verbatim-preserved reason). Both reuse
# `claim_resolve_id`/`claim_current_actor`/`claim_current_gh_login`/`claim_in_job_context`
# from `backlog claim` above rather than re-deriving id/holder/offline logic.

# True (exit 0) iff the caller already holds this unit's claim from here — either the
# backend-recorded holder is them, or a local delivery/<short> branch exists. Mirrors
# `cmd_backlog_claim`'s own "already yours" test (step 3 there) so release/return agree with
# claim about what "held" means, without claim having to expose its internals for reuse.
backlog_is_mine() { # $1=backend $2=root $3=short $4=holder
	local backend="$1" root="$2" short="$3" holder="$4" me=""
	case "$backend" in
		bd) me=$(claim_current_actor "$root") ;;
		gh) me=$(claim_current_gh_login) ;;
	esac
	if [ -n "$holder" ] && [ -n "$me" ] && [ "$holder" = "$me" ]; then
		return 0
	fi
	git -C "$root" show-ref --verify --quiet "refs/heads/delivery/$short"
}

# Commits sitting on delivery/<short> beyond its base — the signal `release` uses to tell "a
# clean claim, safe to fold up" from "unsubmitted work, do not discard it silently". The base
# MUST agree with what `cmd_backlog_claim` actually built delivery/<short> from: claim pushes
# it from origin/main (falling back to local main only when origin/main is unresolvable), so
# release measures against the same ref — never bare local `main`, which routinely lags
# origin/main and would miscount a clean claim as "carrying work" (dotfiles-dft.3 review).
# Echoes 0 (never errors) when the branch does not exist, so callers need no extra guard.
delivery_ahead_count() { # $1=root $2=short
	local root="$1" short="$2" base=main
	if git -C "$root" show-ref --verify --quiet refs/remotes/origin/main; then
		base=origin/main
	fi
	git -C "$root" rev-list --count "$base..delivery/$short" 2>/dev/null || printf '0'
}

# clerk backlog release <id> — give the claim back without finishing (ADR 0015): only claim
# state moves here, never triage state, so stage:ready is left exactly as it was. Refuses if
# delivery/<short> carries commits beyond main — that is real work, and a silent release must
# never be how it gets discarded — pointing the caller at `submit` (save it) or `return`
# (abandon it on purpose, with a lesson) instead. Idempotent: releasing a unit not claimed
# here reports cleanly (exit 0) rather than erroring, the same way `claim`'s own re-claim
# short-circuit treats "already in the state you asked for" as success. Offline mirrors
# `claim`'s SYNC-CHECK: local teardown proceeds attended (only the remote branch delete is
# deferred to the next sync); a job context refuses outright, the same staleness hazard
# `claim` refuses on.
cmd_backlog_release() {
	local backend="$1" root="$2"
	shift 2
	if [ $# -eq 0 ]; then
		usage_error 'clerk backlog release: missing id — usage: clerk backlog release <id>'
	fi
	local id_arg="$1"
	shift
	if [ $# -gt 0 ]; then
		usage_error "clerk backlog release: unknown argument '$1' — usage: clerk backlog release <id>"
	fi

	if ! claim_resolve_id "$backend" "$id_arg"; then
		usage_error "clerk backlog release: $id_arg not found — check the id ('clerk backlog next' shows ready units)"
	fi
	local short="$CLAIM_SHORT" full="$CLAIM_FULL" holder="$CLAIM_HOLDER"

	if ! backlog_is_mine "$backend" "$root" "$short" "$holder"; then
		printf '%sclerk:%s %s is not claimed here (no local delivery/%s) — nothing to release\n' "$C_GRN" "$C_RST" "$full" "$short"
		return 0
	fi

	# SYNC-CHECK (mirrors claim), run BEFORE the ahead-count check below: a reachable origin
	# refreshes the same origin/main ref `cmd_backlog_claim` based delivery/<short> on, so a
	# clean claim is never miscounted as "carrying work" just because local `main` has drifted
	# behind origin/main (dotfiles-dft.3 review).
	local offline=0
	if ! (GIT_TERMINAL_PROMPT=0 timeout 10 git -C "$root" fetch origin >/dev/null 2>&1); then
		offline=1
	fi

	local ahead
	ahead=$(delivery_ahead_count "$root" "$short")
	if [ "$ahead" -gt 0 ]; then
		printf 'clerk: backlog release refused — delivery/%s has %s commit(s) beyond main\n' "$short" "$ahead" >&2
		printf "       run 'clerk backlog submit %s' to save the work, or 'clerk backlog return %s --reason \"<text>\"' to abandon it\n" "$full" "$full" >&2
		return 2
	fi

	if [ "$offline" -eq 1 ] && claim_in_job_context; then
		printf "clerk: OFFLINE in a job context - refusing to release %s: the remote teardown needs origin and no attendant can accept the staleness hazard. Retry when origin is reachable.\n" "$short" >&2
		return 2
	fi

	# Worktree removal is the fail-prone step (git refuses on any uncommitted/untracked file)
	# so it MUST run before any remote mutation: deleting the origin branch first and then
	# failing here would release the CAS lock while this side still holds the local
	# branch/worktree/bd claim — the exact double-claim the lock exists to prevent
	# (dotfiles-dft.3 review). It also must precede the local branch delete: git refuses to
	# delete a branch checked out in a linked worktree.
	local wt="$root/.worktrees/$short"
	if [ -d "$wt" ]; then
		if ! git -C "$root" worktree remove "$wt" 2>/dev/null; then
			backend_fail "release failed — could not remove the worktree at $wt (commit or stash local changes first)"
		fi
	else
		git -C "$root" worktree prune >/dev/null 2>&1
	fi

	if [ "$offline" -eq 0 ] && git -C "$root" show-ref --verify --quiet "refs/remotes/origin/delivery/$short"; then
		if ! git -C "$root" push origin --delete "delivery/$short" >/dev/null 2>&1; then
			backend_fail "release failed — could not delete origin delivery/$short"
		fi
	fi

	if git -C "$root" show-ref --verify --quiet "refs/heads/delivery/$short"; then
		if ! git -C "$root" branch -D "delivery/$short" >/dev/null 2>&1; then
			backend_fail "release failed — could not delete local branch delivery/$short"
		fi
	fi

	case "$backend" in
		bd)
			if ! bd update "$full" --status open --assignee "" >/dev/null; then
				backend_fail "release failed — bd update did not succeed for $full"
			fi
			# mutation self-verify (ADR 0015)
			local json status assignee
			json=$(bd show "$full" --readonly --json 2>/dev/null)
			status=$(printf '%s' "$json" | jq -r '.[0].status // ""')
			assignee=$(printf '%s' "$json" | jq -r '.[0].assignee // ""')
			if [ "$status" != open ] || [ -n "$assignee" ]; then
				backend_fail "release failed — $full was not confirmed open/unassigned after release"
			fi
			;;
		gh)
			local login
			login=$(claim_current_gh_login)
			[ -n "$login" ] && gh issue edit "$full" --remove-assignee "$login" >/dev/null 2>&1
			;;
	esac

	if [ "$offline" -eq 1 ]; then
		printf 'clerk: OFFLINE - delivery/%s deleted locally only; the remote branch delete is deferred to sync (clerk claim/sync will finish it at the next reconnect).\n' "$short" >&2
	fi
	printf '%sclerk:%s released %s — delivery/%s torn down, unit reopened (stage:ready kept)\n' "$C_GRN" "$C_RST" "$full" "$short"
	return 0
}

# clerk backlog return <id> --reason "<text>" — verdict: the unit cannot be fulfilled as
# designed (ADR 0016's counterpart to `submit`'s C4 evidence path). Unlike `release`, this
# never discards anything: delivery/<short> is renamed to returned/<short> so the attempt
# survives as grill evidence (`sync`/`finish` must never touch returned/* — only a grill,
# once it has extracted the lesson, deletes it). The reason is mandatory and is filed
# verbatim as an impediment-typed capture (reusing dft.2's `bd_ensure_impediment_type`/
# `--type impediment` path) so it re-enters the ordinary inbox pipeline instead of sitting as
# free-floating prose on the reopened unit.
archive_existing_returned() { # $1=main-root $2=short $3=offline(0|1)
	local main_root="$1" short="$2" offline="$3" prior_sha archive
	if ! git -C "$main_root" show-ref --verify --quiet "refs/heads/returned/$short"; then
		if git -C "$main_root" show-ref --verify --quiet "refs/remotes/origin/returned/$short"; then
			git -C "$main_root" branch "returned/$short" "origin/returned/$short" >/dev/null 2>&1 ||
				backend_fail "return failed — could not materialize origin/returned/$short for archiving"
		else
			return 0
		fi
	fi
	prior_sha=$(git -C "$main_root" rev-parse --short "returned/$short") ||
		backend_fail "return failed — could not resolve returned/$short before archiving"
	archive="returned/$short-$prior_sha"
	git -C "$main_root" branch -M "returned/$short" "$archive" >/dev/null 2>&1 ||
		backend_fail "return failed — could not archive returned/$short as $archive"
	if [ "$offline" -eq 0 ]; then
		git -C "$main_root" push origin "$archive" >/dev/null 2>&1 ||
			backend_fail "return failed — could not push $archive to origin"
		if git -C "$main_root" show-ref --verify --quiet "refs/remotes/origin/returned/$short"; then
			git -C "$main_root" push origin --delete "returned/$short" >/dev/null 2>&1 ||
				backend_fail "return failed — could not delete origin returned/$short before replacing it"
			git -C "$main_root" update-ref -d "refs/remotes/origin/returned/$short" >/dev/null 2>&1 || true
		fi
	fi
}

cmd_backlog_return() {
	local backend="$1" root="$2"
	shift 2
	if [ $# -eq 0 ]; then
		usage_error 'clerk backlog return: missing id — usage: clerk backlog return <id> --reason "<text>"'
	fi
	local id_arg="$1"
	shift
	local reason=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--reason)
				[ $# -ge 2 ] || usage_error "clerk backlog return: --reason needs a value"
				reason="$2"
				shift
				;;
			*) usage_error "clerk backlog return: unknown argument '$1' — usage: clerk backlog return <id> --reason \"<text>\"" ;;
		esac
		shift
	done
	if [ -z "$reason" ]; then
		usage_error "clerk backlog return: missing --reason — usage: clerk backlog return $id_arg --reason \"<text>\""
	fi

	if ! claim_resolve_id "$backend" "$id_arg"; then
		usage_error "clerk backlog return: $id_arg not found — check the id ('clerk backlog next' shows ready units)"
	fi
	local short="$CLAIM_SHORT" full="$CLAIM_FULL" main_root
	main_root=$(primary_repo_root "$root")

	if ! git -C "$main_root" show-ref --verify --quiet "refs/heads/delivery/$short"; then
		usage_error "clerk backlog return: no local delivery/$short — claim it first ('clerk backlog claim $full')"
	fi

	# SYNC-CHECK (mirrors claim): fetch's failure within a short timeout is the OFFLINE signal.
	local offline=0
	if ! (GIT_TERMINAL_PROMPT=0 timeout 10 git -C "$main_root" fetch origin >/dev/null 2>&1); then
		offline=1
	fi

	if [ "$offline" -eq 1 ] && claim_in_job_context; then
		printf "clerk: OFFLINE in a job context - refusing to return %s: preserving the branch needs origin and no attendant can accept the staleness hazard. Retry when origin is reachable.\n" "$short" >&2
		return 2
	fi

	local sha
	sha=$(git -C "$main_root" rev-parse "delivery/$short")

	# The checkout itself is disposable — the worktree only ever pointed at the branch, which
	# will go on living as returned/<short> regardless. Removal is the fail-prone step (git
	# refuses on any uncommitted/untracked file), so it MUST run BEFORE the rename/remote
	# mutation below: doing the rename+push first and failing here would half-return the unit —
	# delivery/<short> gone, returned/<short> live, but the unit never reopened, stage:ready
	# never stripped, and the mandatory reason never filed, with no way to re-run return
	# (dotfiles-dft.3 review). Running it first means a failure here leaves delivery/<short>
	# completely untouched — fix the worktree, rerun `return` normally.
	local wt="$main_root/.worktrees/$short"
	# If return is invoked from inside the disposable worktree, leave that cwd before removing
	# it; all following git operations must use the primary checkout because the linked
	# worktree path may no longer exist after this point.
	cd "$main_root" || backend_fail "return failed — could not cd to $main_root before cleanup"
	if [ -d "$wt" ]; then
		if ! git -C "$main_root" worktree remove "$wt" 2>/dev/null; then
			backend_fail "return failed — could not remove the worktree at $wt (commit or stash local changes first)"
		fi
	else
		git -C "$main_root" worktree prune >/dev/null 2>&1
	fi

	# PRESERVE THE ATTEMPT: rename, never delete — the commits are the grill evidence.
	# If a previous returned attempt exists, archive it first so the new return can take the
	# canonical returned/<short> name without discarding any evidence.
	archive_existing_returned "$main_root" "$short" "$offline"
	if ! git -C "$main_root" branch -m "delivery/$short" "returned/$short" 2>/dev/null; then
		backend_fail "return failed — could not rename delivery/$short to returned/$short"
	fi

	if [ "$offline" -eq 0 ]; then
		if ! git -C "$main_root" push origin "returned/$short" >/dev/null 2>&1; then
			backend_fail "return failed — could not push returned/$short to origin"
		fi
		if git -C "$main_root" show-ref --verify --quiet "refs/remotes/origin/delivery/$short"; then
			if ! git -C "$main_root" push origin --delete "delivery/$short" >/dev/null 2>&1; then
				backend_fail "return failed — could not delete origin delivery/$short"
			fi
		fi
	fi

	case "$backend" in
		bd)
			if ! bd update "$full" --status open --remove-label stage:ready --assignee "" >/dev/null; then
				backend_fail "return failed — bd update did not succeed for $full"
			fi
			# mutation self-verify (ADR 0015)
			local json status has_label
			json=$(bd show "$full" --readonly --json 2>/dev/null)
			status=$(printf '%s' "$json" | jq -r '.[0].status // ""')
			has_label=$(printf '%s' "$json" | jq -r '(.[0].labels // []) | index("stage:ready")')
			if [ "$status" != open ] || [ "$has_label" != null ]; then
				backend_fail "return failed — $full was not confirmed open/not-ready after return"
			fi
			;;
		gh)
			gh issue reopen "$full" >/dev/null 2>&1
			gh issue edit "$full" --remove-label ready-for-agent >/dev/null 2>&1
			local login
			login=$(claim_current_gh_login)
			[ -n "$login" ] && gh issue edit "$full" --remove-assignee "$login" >/dev/null 2>&1
			;;
	esac

	# The reason capture: verbatim reason, plus the delivery/evidence trail back to
	# returned/<short> (ADR 0016 — this is the grill's raw material, so nothing is summarized).
	local body
	body="$reason"$'\n\n'"returned from delivery of $full"$'\n'"evidence: returned/$short @ $sha"
	local capture_id=""
	case "$backend" in
		bd)
			bd_ensure_impediment_type
			if ! capture_id=$(bd create "backlog return: $full" --description "$body" --type impediment --silent); then
				backend_fail "return failed — could not file the reason capture for $full"
			fi
			local seen
			seen=$(bd show "$capture_id" --readonly --json 2>/dev/null | jq -r '.[0].id // empty')
			if [ "$seen" != "$capture_id" ]; then
				backend_fail "return failed — reason capture $capture_id was not confirmed after filing"
			fi
			;;
		gh)
			if ! capture_id=$(gh issue create --title "backlog return: $full" --body "$body" --label type:impediment 2>/dev/null); then
				backend_fail "return failed — could not file the reason capture for $full"
			fi
			;;
	esac

	if [ "$offline" -eq 1 ]; then
		printf 'clerk: OFFLINE - returned/%s created locally only; pushing it and deleting delivery/%s on origin is deferred to sync (clerk claim/sync will finish it at the next reconnect).\n' "$short" "$short" >&2
	fi
	printf '%sclerk:%s returned %s — returned/%s preserved, reopened, reason filed as %s\n' "$C_GRN" "$C_RST" "$full" "$short" "$capture_id"
	return 0
}

# ------------------------------------------------------ submit + gate (dft.4) ----

GATE_FAILED=0
GATE_FAILURES=""

gate_fail() { # $1 = already-prefixed failure line
	GATE_FAILED=1
	GATE_FAILURES="${GATE_FAILURES}  $1
"
}

gate_finish() {
	if [ "$GATE_FAILED" -eq 0 ]; then
		printf '%sclerk:%s delivery gate passed\n' "$C_GRN" "$C_RST"
		return 0
	fi
	printf 'clerk: delivery gate failed\n' >&2
	printf '%s' "$GATE_FAILURES" >&2
	return 6
}

extract_acceptance_section() {
	awk '
		BEGIN { in_section = 0 }
		/^[[:space:]]{0,3}#{1,6}[[:space:]]*[Aa][Cc][Cc][Ee][Pp][Tt][Aa][Nn][Cc][Ee][[:space:]]+[Cc][Rr][Ii][Tt][Ee][Rr][Ii][Aa][[:space:]]*$/ || /^[[:space:]]*[Aa][Cc][Cc][Ee][Pp][Tt][Aa][Nn][Cc][Ee][[:space:]]+[Cc][Rr][Ii][Tt][Ee][Rr][Ii][Aa]:?[[:space:]]*$/ { in_section = 1; next }
		in_section && /^[[:space:]]{0,3}#{1,6}[[:space:]]+/ { in_section = 0 }
		in_section { print }
	' <<<"$1"
}

criteria_bullets_from_text() {
	awk '
		function trim(s) {
			sub(/^[[:space:]]+/, "", s)
			sub(/[[:space:]]+$/, "", s)
			return s
		}
		function emit(s) {
			s = trim(s)
			if (s != "") {
				print "- " s
				seen = 1
			}
		}
		/^[[:space:]]{0,3}#{1,6}[[:space:]]*[Aa][Cc][Cc][Ee][Pp][Tt][Aa][Nn][Cc][Ee][[:space:]]+[Cc][Rr][Ii][Tt][Ee][Rr][Ii][Aa][[:space:]]*$/ { next }
		/^[[:space:]]*[Aa][Cc][Cc][Ee][Pp][Tt][Aa][Nn][Cc][Ee][[:space:]]+[Cc][Rr][Ii][Tt][Ee][Rr][Ii][Aa]:?[[:space:]]*$/ { next }
		/^[[:space:]]*-[[:space:]]+/ {
			s = $0
			sub(/^[[:space:]]*-[[:space:]]+/, "", s)
			emit(s)
			next
		}
		/^[[:space:]]*[0-9]+[.)][[:space:]]+/ {
			s = $0
			sub(/^[[:space:]]*[0-9]+[.)][[:space:]]+/, "", s)
			emit(s)
			next
		}
		trim($0) != "" { fallback = (fallback == "" ? trim($0) : fallback "\n" trim($0)); fallback_count++ }
		END { if (!seen && fallback_count == 1) print "- " fallback }
	' <<<"$1"
}

unit_acceptance_bullets() {
	local text bullets
	# bd's first-class acceptance_criteria field is criteria by construction; normalize the
	# supported authoring shapes (dash bullets, numbered items, or a single bare criterion) to
	# the dash-bullet contract consumed by PR stamping and the delivery gate. This keeps
	# `inbox ready` and `backlog submit` aligned: a non-empty first-class criteria field that
	# was accepted at ready time cannot become empty only because it used numbered items.
	text="$CLAIM_AC"
	bullets=$(criteria_bullets_from_text "$text")
	if [ -z "$bullets" ]; then
		text=$(extract_acceptance_section "$CLAIM_DESC"$'\n'"$CLAIM_DESIGN")
		bullets=$(criteria_bullets_from_text "$text")
	fi
	printf '%s\n' "$bullets" | sed '/^$/d'
}

body_has_bullet() { # $1=body $2=literal bullet
	grep -Fx -- "$2" <<<"$1" >/dev/null 2>&1
}

stamp_body_with_unit_criteria() { # $1=body-file $2=criteria-file $3=output-file
	local body_file="$1" criteria_file="$2" out_file="$3" body missing=0 bullet
	body=$(cat "$body_file")
	cp "$body_file" "$out_file"
	while IFS= read -r bullet || [ -n "$bullet" ]; do
		[ -n "$bullet" ] || continue
		if ! body_has_bullet "$body" "$bullet"; then
			if [ "$missing" -eq 0 ]; then
				{
					printf '\n## Acceptance criteria\n'
				} >>"$out_file"
				missing=1
			fi
			printf '%s\n' "$bullet" >>"$out_file"
		fi
	done <"$criteria_file"
}

gate_load_body() { # echoes body, returns non-zero on failure
	local body_file="$1"
	[ -f "$body_file" ] || return 1
	cat "$body_file"
}

gate_body_from_ci() { # echoes body, returns non-zero on failure
	local pr="${GITHUB_EVENT_NUMBER:-}"
	if [ -z "$pr" ] && [ -n "${GITHUB_EVENT_PATH:-}" ] && [ -f "$GITHUB_EVENT_PATH" ]; then
		pr=$(jq -r '.pull_request.number // .number // empty' "$GITHUB_EVENT_PATH" 2>/dev/null)
	fi
	[ -n "$pr" ] || return 1
	gh pr view "$pr" --json body --jq .body 2>/dev/null
}

gate_check_body_schema() { # $1=body
	local body="$1"
	grep -qiE '^#{1,6}[[:space:]]*verification[[:space:]]*$' <<<"$body" || gate_fail 'C2 verification: missing ## Verification section'
	grep -qE '^Unit:[[:space:]]*dotfiles-[^[:space:]]+[[:space:]]*$' <<<"$body" || gate_fail 'C2 verification: missing Unit: dotfiles-<short>'
	grep -qE '^Checks:[[:space:]]*$' <<<"$body" || gate_fail 'C2 verification: missing Checks: block'
}

gate_check_linkage() { # $1=branch $2=body
	local branch="$1" body="$2" branch_short unit_lines unit_count unit_short
	case "$branch" in
		delivery/*) branch_short="${branch#delivery/}" ;;
		*)
			gate_fail "C1 protocol: branch must be delivery/<short> (got $branch)"
			branch_short=""
			;;
	esac
	unit_lines=$(grep -E '^Unit:[[:space:]]*dotfiles-[^[:space:]]+[[:space:]]*$' <<<"$body" || true)
	unit_count=$(printf '%s\n' "$unit_lines" | sed '/^$/d' | wc -l | tr -d ' ')
	case "$unit_count" in
		0) gate_fail 'C1 protocol: no linked unit (expected exactly one Unit: dotfiles-<short>)' ;;
		1)
			unit_short=$(printf '%s\n' "$unit_lines" | sed -E 's/^Unit:[[:space:]]*dotfiles-([^[:space:]]+)[[:space:]]*$/\1/')
			if [ -n "$branch_short" ] && [ "$unit_short" != "$branch_short" ]; then
				gate_fail "C1 protocol: linked unit dotfiles-$unit_short does not match branch delivery/$branch_short"
			fi
			;;
		*) gate_fail 'C1 protocol: two linked units (expected exactly one Unit: dotfiles-<short>)' ;;
	esac
}

gate_check_currency() { # $1=branch $2=base-ref $3=head-ref
	local branch="$1" base_ref="$2" head_ref="$3" base_sha merge_base base_branch
	case "$base_ref" in
		origin/*)
			base_branch="${base_ref#origin/}"
			git -C "$GATE_ROOT" fetch origin "$base_branch:refs/remotes/origin/$base_branch" >/dev/null 2>&1 || true
			;;
		*) git -C "$GATE_ROOT" fetch origin >/dev/null 2>&1 || true ;;
	esac
	if ! base_sha=$(git -C "$GATE_ROOT" rev-parse "$base_ref" 2>/dev/null); then
		gate_fail "C1 protocol: could not resolve base $base_ref — fetch origin and retry"
		return 0
	fi
	if ! git -C "$GATE_ROOT" rev-parse "$head_ref" >/dev/null 2>&1; then
		gate_fail "C1 protocol: could not resolve branch $branch — check out delivery/${branch#delivery/} and retry"
		return 0
	fi
	if ! merge_base=$(git -C "$GATE_ROOT" merge-base "$head_ref" "$base_ref" 2>/dev/null); then
		gate_fail "C1 protocol: could not compare $branch with $base_ref"
		return 0
	fi
	if [ "$merge_base" != "$base_sha" ]; then
		gate_fail "C1 protocol: branch is behind $base_ref — run 'git rebase $base_ref'"
	fi
}

gate_check_acceptance_evidence() { # $1=body
	local body="$1" section failures criterion
	if ! has_acceptance_criteria_section "$body"; then
		gate_fail 'C4 acceptance: missing Acceptance criteria section'
		return 0
	fi
	section=$(extract_acceptance_section "$body")
	failures=$(awk '
		function miss() { if (pending != "") print pending; pending = "" }
		/^- / { miss(); pending = $0; next }
		pending != "" && /^[[:space:]]+evidence:[[:space:]]*[^[:space:]]/ { pending = ""; next }
		pending != "" { miss() }
		END { miss() }
	' <<<"$section")
	while IFS= read -r criterion || [ -n "$criterion" ]; do
		[ -n "$criterion" ] || continue
		gate_fail "C4 acceptance: criterion lacks immediate evidence line: $criterion"
	done <<<"$failures"
}

gate_check_executable() {
	local log
	log=$(mktemp)
	if ! (cd "$GATE_ROOT" && bats tests/clerk) >"$log" 2>&1; then
		gate_fail 'C3 executable: bats tests/clerk failed'
		while IFS= read -r line || [ -n "$line" ]; do
			gate_fail "C3 bats: $line"
		done <"$log"
	fi
	: >"$log"
	if ! (cd "$GATE_ROOT" && shellcheck -S error bin/*) >"$log" 2>&1; then
		gate_fail 'C3 executable: shellcheck bin/ failed'
		while IFS= read -r line || [ -n "$line" ]; do
			gate_fail "C3 shellcheck: $line"
		done <"$log"
	fi
	rm -f "$log"
}

cmd_backlog_gate() {
	local _backend="$1" root="$2"
	shift 2
	GATE_ROOT="$root"
	GATE_FAILED=0
	GATE_FAILURES=""
	local branch="" body_file="" base_ref="" ci=0 body head_ref
	while [ $# -gt 0 ]; do
		case "$1" in
			--branch)
				[ $# -ge 2 ] || usage_error 'clerk backlog gate: --branch needs a value — usage: clerk backlog gate --branch delivery/<short> --body-file <path>'
				branch="$2"
				shift
				;;
			--body-file)
				[ $# -ge 2 ] || usage_error 'clerk backlog gate: --body-file needs a path — usage: clerk backlog gate --branch delivery/<short> --body-file <path>'
				body_file="$2"
				shift
				;;
			--base)
				[ $# -ge 2 ] || usage_error 'clerk backlog gate: --base needs a ref'
				base_ref="$2"
				shift
				;;
			--ci) ci=1 ;;
			*) usage_error "clerk backlog gate: unknown argument '$1' — usage: clerk backlog gate --branch delivery/<short> --body-file <path>" ;;
		esac
		shift
	done

	if [ -z "$body_file" ]; then
		if [ "$ci" -eq 1 ] || [ -n "${GITHUB_ACTIONS:-}" ] || [ -n "${GITHUB_EVENT_NAME:-}" ]; then
			ci=1
		else
			usage_error 'clerk backlog gate: missing --body-file — usage: clerk backlog gate --branch delivery/<short> --body-file <path>'
		fi
	fi

	if [ "$ci" -eq 1 ]; then
		branch="${branch:-${GITHUB_HEAD_REF:-}}"
		base_ref="${base_ref:-origin/${GITHUB_BASE_REF:-main}}"
		head_ref="HEAD"
		if ! body=$(gate_body_from_ci); then
			backend_fail 'gate failed — could not read the PR body with gh pr view'
		fi
	else
		if [ -z "$branch" ]; then
			branch=$(git -C "$root" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
		fi
		[ -n "$branch" ] || usage_error 'clerk backlog gate: missing --branch — usage: clerk backlog gate --branch delivery/<short> --body-file <path>'
		base_ref="${base_ref:-origin/main}"
		head_ref="$branch"
		if ! body=$(gate_load_body "$body_file"); then
			usage_error "clerk backlog gate: body file not found: $body_file"
		fi
	fi

	gate_check_linkage "$branch" "$body"
	gate_check_currency "$branch" "$base_ref" "$head_ref"
	gate_check_body_schema "$body"
	gate_check_acceptance_evidence "$body"
	gate_check_executable
	gate_finish
}

cmd_backlog_submit() {
	local backend="$1" root="$2"
	shift 2
	if [ $# -eq 0 ]; then
		usage_error 'clerk backlog submit: missing id — usage: clerk backlog submit <id> --body-file <path>'
	fi
	local id_arg="$1" body_file=""
	shift
	while [ $# -gt 0 ]; do
		case "$1" in
			--body-file)
				[ $# -ge 2 ] || usage_error 'clerk backlog submit: --body-file needs a path — usage: clerk backlog submit <id> --body-file <path>'
				body_file="$2"
				shift
				;;
			*) usage_error "clerk backlog submit: unknown argument '$1' — usage: clerk backlog submit <id> --body-file <path>" ;;
		esac
		shift
	done
	[ -n "$body_file" ] || usage_error 'clerk backlog submit: missing --body-file — usage: clerk backlog submit <id> --body-file <path>'
	[ -f "$body_file" ] || usage_error "clerk backlog submit: body file not found: $body_file"

	if ! claim_resolve_id "$backend" "$id_arg"; then
		usage_error "clerk backlog submit: $id_arg not found — check the id ('clerk backlog next' shows ready units)"
	fi
	local short="$CLAIM_SHORT" full="$CLAIM_FULL" title="$CLAIM_TITLE" branch current_branch
	branch="delivery/$short"
	current_branch=$(git -C "$root" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
	if [ "$current_branch" != "$branch" ]; then
		usage_error "clerk backlog submit: not inside $branch — cd to $root/.worktrees/$short after 'clerk backlog claim $full'"
	fi

	local criteria_file stamped_body
	criteria_file=$(mktemp)
	stamped_body=$(mktemp)
	unit_acceptance_bullets >"$criteria_file"
	if [ ! -s "$criteria_file" ]; then
		rm -f "$criteria_file" "$stamped_body"
		usage_error "clerk backlog submit: $full has no acceptance criteria — return it to discovery before submitting"
	fi
	stamp_body_with_unit_criteria "$body_file" "$criteria_file" "$stamped_body"

	"$0" backlog gate --branch "$branch" --body-file "$stamped_body"
	local rc=$?
	if [ "$rc" -ne 0 ]; then
		rm -f "$criteria_file" "$stamped_body"
		if [ "$rc" -eq 6 ]; then
			return 6
		fi
		return "$rc"
	fi

	if ! git -C "$root" push -u origin "$branch" >/dev/null 2>&1; then
		rm -f "$criteria_file" "$stamped_body"
		backend_fail "submit failed — could not push $branch to origin"
	fi
	if ! gh pr create --head "$branch" --base main --title "$title (dotfiles-$short)" --body-file "$stamped_body"; then
		rm -f "$criteria_file" "$stamped_body"
		backend_fail 'submit failed — gh pr create did not succeed'
	fi
	rm -f "$criteria_file" "$stamped_body"
	printf '%sclerk:%s submitted %s — PR created; awaiting review\n' "$C_GRN" "$C_RST" "$full"
	return 0
}

# ----------------------------------------------------- finish + sync (dft.5) ----

# The reconciler is intentionally stateless (ADR 0015): every run derives the phase from
# observed git + PR + backlog state. Squash merge means branch ancestry is never proof of
# delivery (ADR 0017 ruling 11); only the PR's state/mergedAt can say a unit is merged.

primary_repo_root() { # $1 = any worktree root; echoes the common/main worktree root
	local root="$1" common
	common=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || {
		printf '%s\n' "$root"
		return 0
	}
	case "$common" in
		*/.git) dirname "$common" ;;
		*) printf '%s\n' "$root" ;;
	esac
}

finish_current_short() { # echoes delivery/<short>'s short token, or empty outside one
	local branch
	branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
	case "$branch" in
		delivery/*) printf '%s\n' "${branch#delivery/}" ;;
	esac
}

finish_resolve_unit() { # $1=backend $2=id-or-empty
	local backend="$1" id_arg="${2:-}" short inferred=0
	if [ -z "$id_arg" ]; then
		inferred=1
		short=$(finish_current_short)
		[ -n "$short" ] || return 1
		# bd accepts the short token directly (e.g. `bd show dft.5` resolves dotfiles-dft.5),
		# so never fabricate a prefix from the clone directory name. If the local bd view cannot
		# resolve the short id, refuse below and ask for the explicit full id / refreshed state.
		id_arg="$short"
	fi
	if claim_resolve_id "$backend" "$id_arg"; then
		return 0
	fi
	if [ "$inferred" -eq 1 ] && [ "$backend" = bd ] && [ -n "${short:-}" ]; then
		printf "clerk: could not resolve bead for delivery/%s — run 'bd dolt pull' to refresh local state or rerun 'clerk backlog finish <full-id>'\n" "$short" >&2
	fi
	return 1
}

finish_pr_json() { # $1=branch; echoes the active/merged PR JSON object, or empty
	local branch="$1"
	# A branch can have stale CLOSED PRs (closed without merge, then reopened as a fresh PR).
	# Reconciliation must prefer an active OPEN PR, then the most recent MERGED PR for cleanup,
	# and ignore CLOSED/non-merged PRs. `updatedAt` gives deterministic newest-first choice.
	gh pr list --head "$branch" --state all --json number,url,state,mergedAt,reviewDecision,statusCheckRollup,headRefName,isDraft,updatedAt \
		--jq '([.[] | select(.state == "OPEN")] | sort_by(.updatedAt) | reverse) as $open | ([.[] | select(.state == "MERGED" or (.mergedAt // "") != "")] | sort_by(.updatedAt) | reverse) as $merged | ($open[0] // $merged[0] // empty)' 2>/dev/null
}

finish_check_failures() { # $1=pr-json
	jq -r '
		.statusCheckRollup // [] | .[] |
		(.name // .context // .workflowName // "unnamed check") as $name |
		((.conclusion // "") | ascii_upcase) as $conclusion |
		((.status // "") | ascii_upcase) as $status |
		select(
			$conclusion == "FAILURE" or $conclusion == "TIMED_OUT" or
			$conclusion == "CANCELLED" or $conclusion == "ACTION_REQUIRED" or
			($status == "COMPLETED" and $conclusion != "" and
				$conclusion != "SUCCESS" and $conclusion != "SKIPPED" and $conclusion != "NEUTRAL")
		) |
		$name
	' <<<"$1"
}

finish_check_pending() { # $1=pr-json
	jq -r '
		.statusCheckRollup // [] | .[] |
		(.name // .context // .workflowName // "unnamed check") as $name |
		((.conclusion // "") | ascii_upcase) as $conclusion |
		((.status // "") | ascii_upcase) as $status |
		select($conclusion == "" and $status != "COMPLETED") |
		$name
	' <<<"$1"
}

finish_push_if_needed() { # $1=root $2=short
	local root="$1" short="$2" base_sha merge_base
	if git -C "$root" show-ref --verify --quiet "refs/heads/delivery/$short" &&
		! git -C "$root" show-ref --verify --quiet "refs/remotes/origin/delivery/$short"; then
		git -C "$root" fetch origin main >/dev/null 2>&1 || true
		if base_sha=$(git -C "$root" rev-parse origin/main 2>/dev/null) &&
			merge_base=$(git -C "$root" merge-base "delivery/$short" origin/main 2>/dev/null) &&
			[ "$merge_base" != "$base_sha" ]; then
			printf "clerk: backlog finish refused — delivery/%s is behind origin/main\n" "$short" >&2
			printf "       run 'git rebase origin/main', then rerun 'clerk backlog finish'\n" >&2
			return 2
		fi
		git -C "$root" push -u origin "delivery/$short" >/dev/null 2>&1 ||
			backend_fail "finish failed — could not push delivery/$short to origin"
		git -C "$root" fetch origin >/dev/null 2>&1 || true
	fi
}

finish_cleanup_merged() { # $1=backend $2=root $3=full $4=short $5=pr-number
	local backend="$1" root="$2" full="$3" short="$4" pr_number="$5" main_root wt status
	main_root=$(primary_repo_root "$root")
	# If finish is invoked from inside the worktree it is about to remove, leave that cwd first.
	cd "$main_root" || backend_fail "finish failed — could not cd to $main_root before cleanup"
	wt="$main_root/.worktrees/$short"
	if [ -d "$wt" ]; then
		if ! git -C "$main_root" worktree remove "$wt" >/dev/null 2>&1; then
			backend_fail "finish failed — could not remove the worktree at $wt (commit or stash local changes first)"
		fi
	else
		git -C "$main_root" worktree prune >/dev/null 2>&1 || true
	fi
	if git -C "$main_root" show-ref --verify --quiet "refs/heads/delivery/$short"; then
		git -C "$main_root" branch -D "delivery/$short" >/dev/null 2>&1 ||
			backend_fail "finish failed — could not delete local branch delivery/$short"
	fi
	if git -C "$main_root" ls-remote --exit-code --heads origin "delivery/$short" >/dev/null 2>&1; then
		git -C "$main_root" push origin --delete "delivery/$short" >/dev/null 2>&1 ||
			backend_fail "finish failed — could not delete origin delivery/$short"
		if git -C "$main_root" ls-remote --exit-code --heads origin "delivery/$short" >/dev/null 2>&1; then
			backend_fail "finish failed — origin still advertises delivery/$short after deletion"
		fi
	fi
	case "$backend" in
		bd)
			status="$CLAIM_STATUS"
			if [ "$status" != closed ]; then
				bd close "$full" --reason "delivered: PR #$pr_number merged" >/dev/null ||
					backend_fail "finish failed — bd close did not succeed for $full"
			fi
			local json has_label
			json=$(bd show "$full" --readonly --json 2>/dev/null) ||
				backend_fail "finish failed — could not read $full after finish"
			status=$(printf '%s' "$json" | jq -r '.[0].status // ""')
			[ "$status" = closed ] || backend_fail "finish failed — $full was not confirmed closed after finish"
			bd update "$full" --remove-label stage:ready >/dev/null ||
				backend_fail "finish failed — could not remove stage:ready from $full"
			json=$(bd show "$full" --readonly --json 2>/dev/null) ||
				backend_fail "finish failed — could not read $full after removing stage:ready"
			has_label=$(printf '%s' "$json" | jq -r '(.[0].labels // []) | index("stage:ready")')
			[ "$has_label" = null ] || backend_fail "finish failed — $full was not confirmed without stage:ready after finish"
			bd dolt push >/dev/null || backend_fail 'finish failed — bd dolt push did not succeed'
			;;
		gh)
			gh issue edit "$full" --remove-label ready-for-agent >/dev/null 2>&1 || true
			;;
	esac
	printf '%sclerk:%s finished %s — PR #%s merged, delivery/%s cleaned up, unit closed\n' "$C_GRN" "$C_RST" "$full" "$pr_number" "$short"
}

finish_reconcile_unit() { # $1=backend $2=root $3=id-or-empty $4=watch(0|1) $5=sync(0|1)
	local backend="$1" root="$2" id_arg="$3" watch="$4" sync_mode="$5"
	if ! finish_resolve_unit "$backend" "$id_arg"; then
		if [ "$sync_mode" -eq 1 ]; then
			printf 'clerk: sync: skipped an unresolvable claim id %s\n' "${id_arg:-<current>}"
			return 0
		fi
		usage_error "clerk backlog finish: not inside delivery/<short> and no id was supplied — cd into the claimed worktree or run 'clerk backlog finish <id>'"
	fi
	local full="$CLAIM_FULL" short="$CLAIM_SHORT" branch="delivery/$CLAIM_SHORT" pr_json pr_number pr_state merged_at failures pending review
	finish_push_if_needed "$root" "$short"
	local push_rc=$?
	[ "$push_rc" -eq 0 ] || return "$push_rc"
	pr_json=$(finish_pr_json "$branch")
	if [ -z "$pr_json" ]; then
		if [ "$sync_mode" -eq 1 ]; then
			if ! git -C "$root" show-ref --verify --quiet "refs/heads/$branch" &&
				! git -C "$root" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
				printf 'clerk: sync: %s is claimed but has no delivery/%s branch/worktree — no PR created\n' "$full" "$short"
			else
				printf "clerk: sync: %s has delivery/%s but no PR — no PR created; run 'clerk backlog submit %s --body-file <path-to-pr-body.md>'\n" "$full" "$short" "$full"
			fi
			return 0
		fi
		printf 'clerk: backlog finish refused — no PR found for delivery/%s\n' "$short" >&2
		printf "       run 'clerk backlog submit %s --body-file <path-to-pr-body.md>'\n" "$full" >&2
		return 2
	fi
	pr_number=$(jq -r '.number // empty' <<<"$pr_json")
	pr_state=$(jq -r '.state // ""' <<<"$pr_json")
	merged_at=$(jq -r '.mergedAt // ""' <<<"$pr_json")
	if [ "$pr_state" = MERGED ] || [ -n "$merged_at" ]; then
		finish_cleanup_merged "$backend" "$root" "$full" "$short" "$pr_number"
		return 0
	fi
	if [ "$watch" -eq 1 ]; then
		gh pr checks "$pr_number" --watch || backend_fail "finish failed — gh pr checks --watch failed for PR #$pr_number"
		pr_json=$(finish_pr_json "$branch")
	fi
	failures=$(finish_check_failures "$pr_json")
	if [ -n "$failures" ]; then
		printf 'clerk: PR #%s for %s has failing checks\n' "$pr_number" "$full"
		while IFS= read -r line || [ -n "$line" ]; do
			[ -n "$line" ] || continue
			printf '  %s\n' "$line"
		done <<<"$failures"
		return 1
	fi
	pending=$(finish_check_pending "$pr_json")
	if [ -n "$pending" ]; then
		printf "clerk: PR #%s for %s has pending checks — rerun 'clerk backlog finish' when green (or use --watch)\n" "$pr_number" "$full"
		while IFS= read -r line || [ -n "$line" ]; do
			[ -n "$line" ] || continue
			printf '  %s\n' "$line"
		done <<<"$pending"
		return 0
	fi
	review=$(jq -r '.reviewDecision // ""' <<<"$pr_json")
	case "$review" in
		REVIEW_REQUIRED | CHANGES_REQUESTED)
			printf 'clerk: PR #%s for %s is awaiting review — finish will complete after review\n' "$pr_number" "$full"
			return 0
			;;
	esac
	if ! gh pr merge "$pr_number" --squash --delete-branch=false >/dev/null 2>&1; then
		backend_fail "finish failed — gh pr merge --squash did not succeed for PR #$pr_number"
	fi
	pr_json=$(finish_pr_json "$branch")
	pr_state=$(jq -r '.state // ""' <<<"$pr_json")
	merged_at=$(jq -r '.mergedAt // ""' <<<"$pr_json")
	if [ "$pr_state" != MERGED ] && [ -z "$merged_at" ]; then
		backend_fail "finish failed — PR #$pr_number was not confirmed merged after gh pr merge"
	fi
	finish_cleanup_merged "$backend" "$root" "$full" "$short" "$pr_number"
}

cmd_backlog_finish() {
	local backend="$1" root="$2"
	shift 2
	local watch=0 id_arg=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--watch) watch=1 ;;
			*)
				[ -z "$id_arg" ] || usage_error "clerk backlog finish: unknown argument '$1' — usage: clerk backlog finish [<id>] [--watch]"
				id_arg="$1"
				;;
		esac
		shift
	done
	finish_reconcile_unit "$backend" "$root" "$id_arg" "$watch" 0
}

cmd_sync() {
	local backend="$1" root="$2"
	shift 2
	[ $# -eq 0 ] || usage_error "clerk sync: unknown argument '$1' — usage: clerk sync"
	case "$backend" in
		bd)
			local json count id
			if ! json=$(bd list --status in_progress --json); then
				backend_fail 'sync failed — bd list did not succeed'
			fi
			count=$(jq 'length' <<<"$json")
			printf 'clerk: sync scanning %s open claim(s)\n' "$count"
			while IFS= read -r id || [ -n "$id" ]; do
				[ -n "$id" ] || continue
				finish_reconcile_unit "$backend" "$root" "$id" 0 1 || true
			done < <(jq -r '.[].id' <<<"$json")
			;;
		gh)
			printf 'clerk: sync: gh-backed claim sweep is not available in this generation; skipping\n' >&2
			return 0
			;;
	esac
}

# ---------------------------------------------------------------- doctor ----

DOCTOR_FAILS=0

d_ok() { printf '  %s[ ok ]%s %s\n' "$C_GRN" "$C_RST" "$1"; }
d_warn() { printf '  %s[warn]%s %s\n' "$C_YLW" "$C_RST" "$1"; }
d_fail() {
	printf '  %s[fail]%s %s\n' "$C_RED" "$C_RST" "$1"
	DOCTOR_FAILS=$((DOCTOR_FAILS + 1))
}
d_hint() { printf '         %s\n' "$1"; }

# Symlink-resolved path for comparisons only; raw paths are what we print.
canon() {
	readlink -f -- "$1" 2>/dev/null || printf '%s\n' "$1"
}

cmd_doctor() {
	local fix=0 backend=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--fix) fix=1 ;;
			--backend)
				[ $# -ge 2 ] || usage_error "clerk doctor: --backend needs a value — use --backend bd or --backend gh"
				backend="$2"
				shift
				;;
			--backend=*) backend="${1#--backend=}" ;;
			*) usage_error "clerk doctor: unknown argument '$1' — usage: clerk doctor [--fix --backend bd|gh]" ;;
		esac
		shift
	done
	if [ "$fix" -eq 1 ]; then
		case "$backend" in
			bd | gh) ;;
			'') usage_error "clerk doctor: --fix requires --backend bd|gh — rerun as 'clerk doctor --fix --backend bd' (or gh)" ;;
			*) usage_error "clerk doctor: unknown backend '$backend' — use --backend bd or --backend gh" ;;
		esac
	elif [ -n "$backend" ]; then
		# --backend without --fix would silently do nothing — refuse and prescribe the fix.
		usage_error "clerk doctor: --backend applies only with --fix — rerun with --fix, e.g. 'clerk doctor --fix --backend bd'"
	fi

	local root=""
	root=$(repo_root) || root=""
	if [ -n "$root" ]; then
		printf '%sclerk doctor%s — %s\n' "$C_BOLD" "$C_RST" "$root"
	else
		printf '%sclerk doctor%s\n' "$C_BOLD" "$C_RST"
	fi

	# (a) .clerk marker — doctor owns provisioning (ADR 0017)
	if [ -z "$root" ]; then
		d_fail ".clerk marker: not inside a git repository"
		d_hint "cd into the target repo, then rerun 'clerk doctor'"
	else
		local found="" mrc=0
		found=$(read_marker "$root/.clerk") || mrc=$?
		if [ "$mrc" -eq 0 ]; then
			d_ok ".clerk marker: backlog: $found ($root/.clerk)"
		elif [ "$fix" -eq 1 ]; then
			# Guard the write AND re-validate through read_marker before claiming success —
			# a false "all clear" here dead-ends the dispatch→doctor→dispatch recovery loop.
			if printf 'backlog: %s\n' "$backend" 2>/dev/null >"$root/.clerk" &&
				found=$(read_marker "$root/.clerk"); then
				d_ok ".clerk marker: provisioned backlog: $found ($root/.clerk)"
				d_hint "commit .clerk so worktrees and clones see it: git add .clerk && git commit"
			else
				d_fail ".clerk marker: could not provision ($root/.clerk)"
				d_hint "check that $root is writable and .clerk is not a directory"
			fi
		elif [ "$mrc" -eq 1 ]; then
			d_fail ".clerk marker: missing ($root/.clerk)"
			d_hint "provision it: clerk doctor --fix --backend bd   (or --backend gh)"
		else
			d_fail ".clerk marker: invalid ($root/.clerk)"
			d_hint "expected a single line 'backlog: bd' or 'backlog: gh' (comments after # are fine)"
			d_hint "rewrite it: clerk doctor --fix --backend bd   (or --backend gh)"
		fi
	fi

	# (b) bd shim PATH ordering — a system bd that wins over the shim silently drops the
	# auto-sync the shim exists for (ADR 0013), so a shadowed shim is a hard fail.
	local resolved shim="" cand is_shim=0
	# ${HOME:-} so an unset HOME does not trip `set -u` (cron/systemd have no HOME).
	local -a candidates=("${HOME:-}/.config/bin/bd")
	[ -n "$root" ] && candidates+=("$root/bin/bd")
	resolved=$(command -v bd 2>/dev/null || true)
	for cand in "${candidates[@]}"; do
		[ -x "$cand" ] && { shim="$cand"; break; }
	done
	if [ -z "$resolved" ]; then
		d_warn "bd shim: no 'bd' on PATH — bd-backed verbs will not work until one is installed"
	else
		for cand in "${candidates[@]}"; do
			if [ "$(canon "$resolved")" = "$(canon "$cand")" ]; then
				is_shim=1
				break
			fi
		done
		if [ "$is_shim" -eq 1 ]; then
			d_ok "bd shim: $resolved (shim wins PATH resolution)"
		elif [ -n "$shim" ]; then
			d_fail "bd shim: SHADOWED — 'bd' resolves to $resolved, expected shim $shim"
			d_hint "fix: put $(dirname "$shim") before $(dirname "$resolved") in PATH"
		else
			d_warn "bd shim: 'bd' resolves to $resolved and no clerk-managed shim exists (~/.config/bin/bd or <repo>/bin/bd)"
		fi
	fi

	# (c) version parity — one variable at the top of this script feeds both surfaces
	d_ok "version: clerk $CLERK_VERSION (clerk --version reports the same string)"

	# (d) gh auth — non-fatal report
	if ! command -v gh >/dev/null 2>&1; then
		d_warn "gh auth: gh not on PATH (non-fatal) — install gh before using gh-backed verbs"
	elif gh auth status >/dev/null 2>&1; then
		d_ok "gh auth: authenticated"
	else
		d_warn "gh auth: not authenticated (non-fatal) — run 'gh auth login' before gh-backed verbs"
	fi

	if [ "$DOCTOR_FAILS" -eq 0 ]; then
		printf '%sclerk doctor: all clear%s\n' "$C_GRN" "$C_RST"
		return 0
	fi
	printf '%sclerk doctor: %d problem(s) — fix the [fail] lines above%s\n' "$C_RED" "$DOCTOR_FAILS" "$C_RST"
	return 1
}

# ---------------------------------------------------------------- glean (dft.6) ---

# Watermark state directory. Tests may override with CLERK_GLEAN_STATE_DIR.
GLEAN_STATE_DIR="${CLERK_GLEAN_STATE_DIR:-${HOME:-}/.local/state/clerk}"

# Minimum chunk size (lines) to trigger a judgment fork. Tests may override.
GLEAN_MIN_CHUNK_LINES="${CLERK_GLEAN_MIN_CHUNK_LINES:-50}"

# Transcript project directory. Tests may override with one scratch transcript directory;
# production derives the current repo/worktree's Claude Code project slug instead of
# sweeping the whole archive.
GLEAN_PROJECTS_ROOT="${CLERK_GLEAN_PROJECTS_ROOT:-${HOME:-}/.config/claude-code/projects}"

# Flock lock file for single-instance guarantee
GLEAN_LOCK_FILE="${GLEAN_STATE_DIR}/glean.lock"

# Ensure state directory exists
glean_ensure_state_dir() {
	mkdir -p "$GLEAN_STATE_DIR"
}

# Acquire flock lock (non-blocking). Returns 0 if acquired, 1 if another instance holds it.
glean_acquire_lock() {
	# Create lock file if it doesn't exist
	touch "$GLEAN_LOCK_FILE" 2>/dev/null || return 1
	# Try to acquire exclusive non-blocking lock on fd 9
	exec 9<>"$GLEAN_LOCK_FILE"
	if flock -n 9; then
		return 0
	else
		exec 9>&-
		return 1
	fi
}

# Release flock lock
glean_release_lock() {
	exec 9>&- 2>/dev/null || true
}

# Read watermark for a transcript file. Returns the line offset (0 if never harvested).
glean_read_watermark() {
	local transcript_file="$1"
	local watermark_file
	watermark_file="$(glean_watermark_path "$transcript_file")"
	[ -f "$watermark_file" ] || { printf '0'; return 0; }
	cat "$watermark_file" 2>/dev/null || printf '0'
}

# Write watermark for a transcript file (atomic via temp file)
glean_write_watermark() {
	local transcript_file="$1" offset="$2"
	local watermark_file
	watermark_file="$(glean_watermark_path "$transcript_file")"
	local tmp_file
	tmp_file="$(mktemp "${watermark_file}.tmp.XXXXXX")" || return 1
	printf '%s' "$offset" >"$tmp_file" || { rm -f "$tmp_file"; return 1; }
	mv "$tmp_file" "$watermark_file" || { rm -f "$tmp_file"; return 1; }
}

# Compute watermark file path from transcript file path
glean_watermark_path() {
	local transcript_file="$1"
	# Use a hash of the absolute path to avoid collisions
	local abs_path hash
	abs_path=$(readlink -f "$transcript_file" 2>/dev/null || printf '%s' "$transcript_file")
	hash=$(printf '%s' "$abs_path" | sha256sum | cut -d' ' -f1)
	printf '%s/%s.watermark' "$GLEAN_STATE_DIR" "$hash"
}

# Claude Code's project transcript slug is the absolute cwd with slashes replaced by dashes
# (e.g. /home/me/repo -> -home-me-repo). Worktrees get their own slugs, which is exactly
# where their session transcripts live.
glean_project_slug() { # $1=root
	local root="$1"
	root=$(cd "$root" 2>/dev/null && pwd -P) || printf '%s' "$root"
	printf '%s' "$root" | tr '/' '-'
}

glean_transcript_dirs() { # $1=root, NUL-separated output
	local root="$1" slug
	if [ -n "${CLERK_GLEAN_TRANSCRIPT_DIR:-}" ]; then
		printf '%s\0' "$CLERK_GLEAN_TRANSCRIPT_DIR"
		return 0
	fi
	slug=$(glean_project_slug "$root")
	printf '%s\0' "$GLEAN_PROJECTS_ROOT/$slug"
}

# Build the judgment fork prompt for a chunk of transcript lines
glean_build_judgment_prompt() {
	local chunk_file="$1" transcript_file="$2" chunk_start="$3" chunk_end="$4"
	cat <<'EOF'
You are a retrospective friction harvester (glean). You are reading a CHUNK of a Claude Code session transcript (JSONL lines) to find IMPEDIMENTS: friction the agent routed around that would recur and cost tokens unless an instruction, skill, or tool changes.

IMPEDIMENT DEFINITION (ADR 0012): friction the agent had to route around that *would recur and cost tokens again unless an instruction, skill, or tool changed*. A bare `is_error` from normal probing (empty grep, a guard that fails) is NOT an impediment; a denied permission, an interface retried three times, a misfiring bundled skill, or an ambiguous injected instruction IS.

Highest-value class: friction with *our own* instructions/skills — those we can actually fix.

For each impediment you find, output ONE JSON object on its own line with this exact shape:
{
  "type": "impediment",
  "title": "<one-line summary, <=80 chars>",
  "body": "<evidence-rich description: quote the failing command, the error, the retry count, roughly what it cost. Do NOT decide the fix — choosing which instruction to change is a grill decision, not a capture-time call.>",
  "transcript_file": "<path>",
  "chunk_lines": "<start>-<end>"
}

If you find no impediments, output exactly one JSON object:
{"type":"none","reason":"<why no recurring workflow/tooling friction was found>"}

Malformed output is treated as a failed harvest and the watermark will not advance.

Categories (ADR 0016 loop map) — this run only emits `type: impediment`. Future categories: `criteria-miss`, `sort-miss`, `prep-miss`.

EOF
	printf 'TRANSCRIPT CHUNK (lines %s-%s of %s):\n' "$chunk_start" "$chunk_end" "$transcript_file"
	cat "$chunk_file"
}

# Spawn judgment fork for a chunk. Returns capture IDs on success, empty on an explicit
# no-findings result, and non-zero on malformed/failed judgment or filing.
glean_judgment_fork() {
	local chunk_file="$1" transcript_file="$2" chunk_start="$3" chunk_end="$4"
	local prompt_file output_file candidates_file capture_id
	prompt_file=$(mktemp)
	output_file=$(mktemp)
	candidates_file=$(mktemp)
	glean_build_judgment_prompt "$chunk_file" "$transcript_file" "$chunk_start" "$chunk_end" >"$prompt_file"

	# Invoke the judgment fork. Tests may set CLERK_GLEAN_JUDGMENT_CMD to a deterministic
	# command that reads the prompt on stdin and emits JSONL. Production requires a model
	# runner; no output / malformed output is a failed harvest, not a successful no-op.
	local rc=0
	if [ -n "${CLERK_GLEAN_JUDGMENT_CMD:-}" ]; then
		bash -c "$CLERK_GLEAN_JUDGMENT_CMD" <"$prompt_file" >"$output_file" || rc=$?
	elif command -v claude >/dev/null 2>&1; then
		claude -p <"$prompt_file" >"$output_file" || rc=$?
	else
		printf 'clerk glean: no judgment runner available (expected claude on PATH)\n' >&2
		rm -f "$prompt_file" "$output_file" "$candidates_file"
		return 5
	fi
	if [ "$rc" -ne 0 ]; then
		rm -f "$prompt_file" "$output_file" "$candidates_file"
		return "$rc"
	fi
	if ! grep -q '[^[:space:]]' "$output_file"; then
		printf 'clerk glean: judgment fork produced no JSONL; watermark not advanced\n' >&2
		rm -f "$prompt_file" "$output_file" "$candidates_file"
		return 5
	fi

	local candidate ctype title body seen_any=0 seen_none=0 seen_impediment=0
	while IFS= read -r candidate || [ -n "$candidate" ]; do
		[[ "$candidate" =~ [^[:space:]] ]] || continue
		seen_any=1
		if ! printf '%s' "$candidate" | jq -e 'type == "object" and (.type == "none" or .type == "impediment")' >/dev/null 2>&1; then
			printf 'clerk glean: malformed judgment JSONL; watermark not advanced\n' >&2
			rm -f "$prompt_file" "$output_file" "$candidates_file"
			return 5
		fi
		ctype=$(printf '%s' "$candidate" | jq -r '.type')
		case "$ctype" in
			none)
				seen_none=1
				;;
			impediment)
				title=$(printf '%s' "$candidate" | jq -r '.title // empty')
				body=$(printf '%s' "$candidate" | jq -r '.body // empty')
				if [ -z "$title" ] || [ -z "$body" ]; then
					printf 'clerk glean: impediment candidate missing title/body; watermark not advanced\n' >&2
					rm -f "$prompt_file" "$output_file" "$candidates_file"
					return 5
				fi
				printf '%s\n' "$candidate" >>"$candidates_file"
				seen_impediment=1
				;;
		esac
	done <"$output_file"

	if [ "$seen_any" -eq 0 ] || { [ "$seen_none" -eq 1 ] && [ "$seen_impediment" -eq 1 ]; }; then
		printf 'clerk glean: ambiguous judgment output; watermark not advanced\n' >&2
		rm -f "$prompt_file" "$output_file" "$candidates_file"
		return 5
	fi
	if [ "$seen_none" -eq 1 ]; then
		rm -f "$prompt_file" "$output_file" "$candidates_file"
		return 0
	fi

	while IFS= read -r candidate || [ -n "$candidate" ]; do
		local source_key
		title=$(printf '%s' "$candidate" | jq -r '.title')
		body=$(printf '%s' "$candidate" | jq -r '.body')
		source_key=$(printf '%s\n%s:%s-%s' "$candidate" "$transcript_file" "$chunk_start" "$chunk_end" | sha256sum | cut -d' ' -f1)
		if ! capture_id=$(glean_file_capture "$title" "$body" impediment "glean-source:$source_key"); then
			rm -f "$prompt_file" "$output_file" "$candidates_file"
			return 5
		fi
		printf '%s\n' "$capture_id"
	done <"$candidates_file"
	rm -f "$prompt_file" "$output_file" "$candidates_file"
}

glean_existing_capture() { # $1=source-key
	local source_key="$1"
	case "${GLEAN_BACKEND:-bd}" in
		bd) bd search --desc-contains "$source_key" --readonly --json 2>/dev/null | jq -r '.[0].id // empty' ;;
		gh) gh issue list --search "$source_key" --json url --jq '.[0].url // empty' 2>/dev/null ;;
	esac
}

# File a capture through the repo's configured clerk backend (used after the judgment fork
# emits JSONL candidates). A deterministic glean-source key makes retries idempotent when
# a later candidate in the same chunk fails before the chunk watermark can advance.
glean_file_capture() {
	local title="$1" body="$2" type="${3:-impediment}" source_key="$4"
	local existing body_file
	existing=$(glean_existing_capture "$source_key")
	if [ -n "$existing" ]; then
		printf '%s\n' "$existing"
		return 0
	fi
	body_file=$(mktemp)
	printf '%s\n\n%s\n' "$body" "$source_key" >"$body_file" || { rm -f "$body_file"; return 1; }
	case "${GLEAN_BACKEND:-bd}" in
		bd)
			[ "$type" = impediment ] && bd_ensure_impediment_type
			local id seen
			id=$(bd create "$title" --body-file "$body_file" --type "$type" --silent) || { rm -f "$body_file"; return 1; }
			seen=$(bd show "$id" --readonly --json 2>/dev/null | jq -r '.[0].id // empty')
			[ "$seen" = "$id" ] || { rm -f "$body_file"; return 1; }
			printf '%s\n' "$id"
			;;
		gh)
			local url
			url=$(gh issue create --title "$title" --body-file "$body_file" --label "type:$type") || { rm -f "$body_file"; return 1; }
			printf '%s\n' "$url"
			;;
	esac
	rm -f "$body_file"
}

# Process a single transcript file: harvest unharvested chunks
glean_process_transcript() {
	local transcript_file="$1"
	[ -f "$transcript_file" ] || return 0
	[ -s "$transcript_file" ] || return 0

	local watermark_offset
	watermark_offset=$(glean_read_watermark "$transcript_file")

	local total_lines
	total_lines=$(wc -l <"$transcript_file")
	[ "$watermark_offset" -lt "$total_lines" ] || return 0  # Nothing new

	local chunk_start=$((watermark_offset + 1))
	local chunk_end=0
	local line_num=0
	local chunk_file

	chunk_file=$(mktemp)

	while IFS= read -r line || [ -n "$line" ]; do
		line_num=$((line_num + 1))
		[ "$line_num" -le "$watermark_offset" ] && continue

		printf '%s\n' "$line" >>"$chunk_file"
		chunk_end=$line_num

		# Check if chunk is large enough to process
		local chunk_size=$((chunk_end - chunk_start + 1))
		if [ "$chunk_size" -ge "$GLEAN_MIN_CHUNK_LINES" ]; then
			# Spawn judgment fork for this chunk
			local capture_id
			if ! capture_id=$(glean_judgment_fork "$chunk_file" "$transcript_file" "$chunk_start" "$chunk_end"); then
				printf 'glean: judgment fork failed for %s lines %s-%s; watermark not advanced\n' "$transcript_file" "$chunk_start" "$chunk_end" >&2
				rm -f "$chunk_file"
				return 1
			fi
			if [ -n "$capture_id" ]; then
				printf '  filed %s (lines %s-%s)\n' "$capture_id" "$chunk_start" "$chunk_end"
			else
				printf '  judgment fork returned no capture for lines %s-%s\n' "$chunk_start" "$chunk_end"
			fi

			# ADVANCE WATERMARK ONLY AFTER SUCCESSFUL FILING (crash-safe)
			glean_write_watermark "$transcript_file" "$chunk_end" || {
				printf 'glean: failed to write watermark for %s\n' "$transcript_file" >&2
				rm -f "$chunk_file"
				return 1
			}

			# Reset for next chunk
			chunk_start=$((chunk_end + 1))
			: >"$chunk_file"
		fi
	done <"$transcript_file"

	# Handle final sub-threshold chunk (log skip, don't harvest)
	if [ "$chunk_start" -le "$total_lines" ]; then
		local remaining=$((total_lines - chunk_start + 1))
		if [ "$remaining" -gt 0 ] && [ "$remaining" -lt "$GLEAN_MIN_CHUNK_LINES" ]; then
			printf 'glean: sub-threshold chunk skipped (%s lines, min %s) in %s\n' "$remaining" "$GLEAN_MIN_CHUNK_LINES" "$transcript_file"
		fi
	fi

	rm -f "$chunk_file"
	return 0
}

# Main glean command
glean_main() {
	local root="$1"
	shift
	local async=0
	while [ $# -gt 0 ]; do
		case "$1" in
			--async) async=1 ;;
			*) usage_error "clerk glean: unknown argument '$1' — usage: clerk glean [--async]" ;;
		esac
		shift
	done

	glean_ensure_state_dir

	if [ "$async" -eq 1 ]; then
		local log_file="$GLEAN_STATE_DIR/glean.log"
		("$0" glean >>"$log_file" 2>&1 &)
		printf 'glean: async harvest started (log: %s)\n' "$log_file"
		return 0
	fi

	# Single-instance flock guard
	if ! glean_acquire_lock; then
		printf 'glean: another instance is running — exiting\n' >&2
		return 0  # Not an error, just another instance won
	fi

	# Release the lock on normal exit, but terminate immediately on signals. A TERM/INT
	# during the judgment fork must never continue into watermark advancement.
	trap glean_release_lock EXIT
	trap 'glean_release_lock; exit 130' INT
	trap 'glean_release_lock; exit 143' TERM

	local -a transcript_files=() transcript_dirs=()
	local dir dirs_display=""

	while IFS= read -r -d '' dir; do
		transcript_dirs+=("$dir")
		done < <(glean_transcript_dirs "$root")
	for dir in "${transcript_dirs[@]}"; do
		dirs_display+="${dirs_display:+ }$dir"
		[ -d "$dir" ] || continue
		# Find all .jsonl files (main + subagent transcripts)
		while IFS= read -r -d '' file; do
			transcript_files+=("$file")
		done < <(find "$dir" -type f -name '*.jsonl' -print0 2>/dev/null)
	done

	if [ "${#transcript_files[@]}" -eq 0 ]; then
		printf 'glean: no transcript files found in %s\n' "$dirs_display"
		return 0
	fi

	printf 'glean: scanning %s transcript file(s)\n' "${#transcript_files[@]}"

	local file
	for file in "${transcript_files[@]}"; do
		printf '  harvesting %s\n' "$file"
		glean_process_transcript "$file" || {
			printf 'glean: failed to process %s\n' "$file" >&2
			# Don't exit - continue with other files
		}
	done

	printf 'glean: harvest complete\n'
	return 0
}

cmd_glean() {
	local backend="$1" _root="$2"
	shift 2
	GLEAN_BACKEND="$backend"
	glean_main "$_root" "$@"
}

# ------------------------------------------------------------------ main ----

main() {
	# --explain / --help may sit anywhere in the argument list; strip them, keep the verb path.
	local explain=0 help=0 a
	local -a args=()
	for a in "$@"; do
		case "$a" in
			--explain) explain=1 ;;
			--help | -h) help=1 ;;
			*) args+=("$a") ;;
		esac
	done
	set -- ${args[@]+"${args[@]}"}

	if [ $# -eq 0 ]; then
		if [ "$explain" -eq 1 ]; then
			usage_error "clerk: --explain needs a verb — e.g. 'clerk --explain backlog claim'"
		fi
		if [ "$help" -eq 1 ]; then
			printf 'clerk %s — workflow verb facade (ADR 0015)\n' "$CLERK_VERSION"
			print_roster
			exit 0
		fi
		printf 'clerk: missing verb\n' >&2
		print_roster >&2
		exit 2
	fi

	case "$1" in
		--version | -V)
			printf 'clerk %s\n' "$CLERK_VERSION"
			exit 0
			;;
	esac

	local verb="" noun sub roster w sub_known gate_root
	case "$1" in
		capture | sync | doctor | glean)
			verb="$1"
			shift
			;;
		inbox | backlog)
			noun="$1"
			shift
			if [ $# -eq 0 ]; then
				printf "clerk: '%s' needs a verb\n" "$noun" >&2
				print_roster >&2
				exit 2
			fi
			sub="$1"
			if [ "$noun" = inbox ]; then
				roster="list show dups ready drop pregrill"
			else
				roster="next show claim release submit gate finish return"
			fi
			# Exact-word match — a glob over " $roster " would misread one argument
			# equal to two adjacent roster words (e.g. 'list show') as a known verb.
			sub_known=0
			for w in $roster; do
				if [ "$sub" = "$w" ]; then
					sub_known=1
					break
				fi
			done
			if [ "$sub_known" -eq 1 ]; then
				verb="$noun $sub"
				shift
			else
				unknown_verb "$noun $sub"
			fi
			;;
		*) unknown_verb "$1" ;;
	esac

	if [ "$explain" -eq 1 ] || [ "$help" -eq 1 ]; then
		explain_verb "$verb"
		exit 0
	fi

	if [ "$verb" = doctor ]; then
		cmd_doctor "$@"
		exit "$?"
	fi

	# The delivery-gate is server-side proof over git/PR-visible state. It deliberately does
	# not read the backlog marker or backend; GitHub Actions must be able to run it before the
	# repo's `.clerk` cutover (ADR 0016, dotfiles-dft.4).
	if [ "$verb" = "backlog gate" ]; then
		gate_root=$(repo_root) || {
			printf "clerk: not inside a git repository — cd into the target repo, then rerun 'clerk backlog gate'\n" >&2
			exit 4
		}
		cmd_backlog_gate "" "$gate_root" "$@"
		exit "$?"
	fi

	# Everything else dispatches on the .clerk marker (ADR 0017) …
	marker_gate
	# … and, for the verbs this generation implements (dotfiles-dft.2), on the marker's
	# backend. Every cmd_* callee takes (backend, root, …verb-args…) uniformly, even the
	# ones that do not need root, so this dispatch line stays one shape for all seven.
	local root backend
	root=$(repo_root)
	backend=$(read_marker "$root/.clerk")
	case "$verb" in
		capture)
			cmd_capture "$backend" "$root" "$@"
			exit "$?"
			;;
		sync)
			cmd_sync "$backend" "$root" "$@"
			exit "$?"
			;;
		"inbox list")
			cmd_inbox_list "$backend" "$root"
			exit "$?"
			;;
		"inbox show")
			cmd_inbox_show "$backend" "$root" "$@"
			exit "$?"
			;;
		"inbox dups")
			cmd_inbox_dups "$backend" "$root"
			exit "$?"
			;;
		"inbox ready")
			cmd_inbox_ready "$backend" "$root" "$@"
			exit "$?"
			;;
		"inbox drop")
			cmd_inbox_drop "$backend" "$root" "$@"
			exit "$?"
			;;
		"inbox pregrill")
			cmd_inbox_pregrill "$backend" "$root" "$@"
			exit "$?"
			;;
		"backlog next")
			cmd_backlog_next "$backend" "$root"
			exit "$?"
			;;
		"backlog show")
			cmd_backlog_show "$backend" "$root" "$@"
			exit "$?"
			;;
		"backlog claim")
			cmd_backlog_claim "$backend" "$root" "$@"
			exit "$?"
			;;
		"backlog release")
			cmd_backlog_release "$backend" "$root" "$@"
			exit "$?"
			;;
		"backlog return")
			cmd_backlog_return "$backend" "$root" "$@"
			exit "$?"
			;;
		"backlog gate")
			cmd_backlog_gate "$backend" "$root" "$@"
			exit "$?"
			;;
		"backlog submit")
			cmd_backlog_submit "$backend" "$root" "$@"
			exit "$?"
			;;
		"backlog finish")
			cmd_backlog_finish "$backend" "$root" "$@"
			exit "$?"
			;;
		glean)
			cmd_glean "$backend" "$root" "$@"
			exit "$?"
			;;
	esac
	# … and the rest is delivered by a later unit of the dotfiles-dft epic.
	not_implemented "$verb"
}

main "$@"
