#!/usr/bin/env bash
# clerk public launcher: resolve this checkout and hand off to the stdlib Python
# Clerk project, or to the preserved legacy shell implementation when explicitly forced.
set -uo pipefail

clerk_error() {
	printf 'clerk: %s\n' "$1" >&2
	if [ "$#" -gt 1 ]; then
		shift
		printf '       %s\n' "$@" >&2
	fi
}

source_path=${BASH_SOURCE[0]}
while [ -L "$source_path" ]; do
	source_dir=${source_path%/*}
	[ "$source_dir" != "$source_path" ] || source_dir=.
	if ! source_dir=$(cd -P -- "$source_dir" 2>/dev/null && pwd); then
		clerk_error "cannot resolve launcher directory — cd into the dotfiles checkout, then rerun 'clerk doctor'"
		exit 4
	fi
	if ! target=$(readlink "$source_path" 2>/dev/null); then
		clerk_error "cannot resolve launcher symlink — cd into the dotfiles checkout, then rerun 'clerk doctor'"
		exit 4
	fi
	case "$target" in
		/*) source_path=$target ;;
		*) source_path=$source_dir/$target ;;
	esac
done

bin_dir=${source_path%/*}
[ "$bin_dir" != "$source_path" ] || bin_dir=.
if ! bin_dir=$(cd -P -- "$bin_dir" 2>/dev/null && pwd); then
	clerk_error "cannot resolve launcher directory — cd into the dotfiles checkout, then rerun 'clerk doctor'"
	exit 4
fi
if ! repo_root=$(cd -P -- "$bin_dir/.." 2>/dev/null && pwd); then
	clerk_error "cannot resolve dotfiles checkout — cd into the dotfiles checkout, then rerun 'clerk doctor'"
	exit 4
fi

legacy_path=$repo_root/clerk/legacy/clerk.bash
python_src=$repo_root/clerk/src

if [ -n "${CLERK_FORCE_LEGACY:-}" ] && [ "${CLERK_FORCE_LEGACY:-}" != 0 ]; then
	exec "$legacy_path" "$@"
fi

find_python() {
	local candidate
	for candidate in "${CLERK_PYTHON:-}" python3 python; do
		[ -n "$candidate" ] || continue
		command -v -- "$candidate" >/dev/null 2>&1 || continue
		if "$candidate" - <<'PY' >/dev/null 2>&1
import sys
raise SystemExit(0 if sys.version_info >= (3, 11) else 1)
PY
		then
			printf '%s\n' "$candidate"
			return 0
		fi
	done
	return 1
}

if ! python_bin=$(find_python); then
	clerk_error "Python 3.11 or newer is required to run Clerk" \
		"install Python 3.11+, set CLERK_PYTHON to its path, or rerun with CLERK_FORCE_LEGACY=1" \
		"then run 'clerk doctor' if setup is still unclear"
	exit 4
fi

PYTHONPATH="$python_src${PYTHONPATH:+:$PYTHONPATH}" \
CLERK_REPO_ROOT="$repo_root" \
CLERK_LEGACY_PATH="$legacy_path" \
exec "$python_bin" -m clerk "$@"
