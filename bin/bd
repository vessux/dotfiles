#!/usr/bin/env bash
# bd — a transparent PATH shim around the real `bd` that auto-syncs the private beads
# inbox (ADR 0013, dotfiles-zao). After a MUTATING `bd`, it flushes captures to the Dolt
# remote via a DEBOUNCED, NONBLOCKING, CRASH-SAFE background coordinator — so captures sync
# with zero operating-rule discipline and no git hooks. Reads/sync-plumbing pass straight
# through (exec, no overhead). PULLS stay explicit (`bd dolt pull`) — a freshness read can't
# be debounced and is not this shim's job.
#
# Lives at ~/.config/bin/bd (ADR 0001's `bin/` stow package, prepended to PATH in .zshenv),
# so it shadows the real bd (e.g. /usr/local/bin/bd). It locates the real bd as the next
# `bd` on PATH that isn't itself; set BD_REAL_BIN to skip that scan on the hot path.
#
# Why a detached coordinator and not `bd … && bd dolt push &`: the naive form is exactly the
# racy fire-and-forget `dolt.auto-push` that sp0 found broken — the push dies when the
# short-lived bd process (and shell) exits before the network round-trip. The fix (proven
# 6/6 incl. crash-recovery in the zao prototype) is a setsid-detached coordinator holding a
# kernel flock(2) for its life: it survives the triggering shell's exit, coalesces a burst
# into one push, and self-heals after a SIGKILL (the kernel releases the lock — no stale
# artifact, no pid-reaping race).
#
# BD_SHIM_SYNC=1 switches the push from detached to SYNCHRONOUS (push-and-wait). Use it for
# an automated devbox delivery job: the harness SIGKILLs the job's whole process tree at exit
# (container/cgroup), which setsid does NOT escape, so a pending background push would die
# with the job — the correctness-critical write (esp. `close`) must land on the remote first.
#
# Portability bar (this runs on macOS discovery + Linux devbox): bash + perl + `date +%s`
# only. No flock(1) (macOS has none), no GNU-only flags, no md5/sha (cksum is POSIX). bash
# 3.2-safe (macOS system bash) — no associative arrays, no ${x,,}.
set -uo pipefail

# Marker arg the coordinator re-execs itself with (see _flush_trigger). Plain var, not
# readonly, so sourcing this file (the test harness does) more than once can't error.
_BD_SHIM_COORD_ARG="__bd_shim_coordinator_loop"
# Path to THIS file, captured whether executed or sourced; resolved lazily by _self_path.
_BD_SHIM_SRC="${BASH_SOURCE[0]}"
_BD_SHIM_SELF=""

# Resolved .beads directory and the two metadata.json fields we care about.
# Deliberately NOT named BEADS_DIR: that is bd's own env var, and assigning to it
# here would clobber a caller's export. Initialised so `set -u` is safe when this
# file is sourced (the test harness) without _bd_shim_main running.
_BD_BEADS_DIR=""
_BD_META_MODE=""
_BD_META_DB=""

_now() { date +%s; }

# Absolute, symlink-resolved path of $1 without GNU `realpath`/`readlink -f` (macOS ships
# neither). Bare one-arg `readlink` is POSIX and present on macOS + Linux.
_resolve() {
	local p="$1" t
	while [ -L "$p" ]; do
		t=$(readlink "$p")
		case "$t" in
			/*) p="$t" ;;
			*) p="$(cd "$(dirname "$p")" && pwd)/$t" ;;
		esac
	done
	printf '%s/%s\n' "$(cd "$(dirname "$p")" && pwd)" "$(basename "$p")"
}

_self_path() {
	[ -n "$_BD_SHIM_SELF" ] && { printf '%s\n' "$_BD_SHIM_SELF"; return 0; }
	_BD_SHIM_SELF=$(_resolve "$_BD_SHIM_SRC")
	printf '%s\n' "$_BD_SHIM_SELF"
}

# The real bd = first executable `bd` on PATH whose symlink-resolved path isn't ours
# (~/.config/bin/bd resolves to this very file). Pure-bash scan, no `which` subprocess.
_find_real_bd() {
	local self d cand oldifs
	self=$(_self_path)
	oldifs=$IFS; IFS=:; set -- $PATH; IFS=$oldifs
	for d in "$@"; do
		[ -n "$d" ] || d="."
		cand="$d/bd"
		if [ -x "$cand" ] && [ ! -d "$cand" ] && [ "$(_resolve "$cand")" != "$self" ]; then
			printf '%s\n' "$cand"
			return 0
		fi
	done
	return 1
}

# Trigger-by-default classifier. A spurious debounced push is a cheap, coalesced, idempotent
# no-op; a MISSED mutation is a silently-unsynced capture — the exact bug the shim kills. So
# the default is "mutating", and only known reads / sync-plumbing / setup are excluded.
# `dolt` MUST be excluded: the coordinator's own `bd dolt push` would otherwise re-trigger.
_is_mutating() {
	local s="$1"
	[ -n "$s" ] || return 1
	case "$s" in
		# reads / views — nothing to sync
		list|show|query|search|count|diff|history|lint|stale|status|statuses|types|\
		graph|blocked|children|comments|state|where|info|context|prime|onboard|\
		quickstart|human|preflight|find-duplicates|duplicates|memories|recall|\
		export|backup|ping|doctor|ready|help|completion|version)
			return 1 ;;
		# sync plumbing / setup / local-only config — not an issue-data mutation to sync
		dolt|vc|branch|federation|repo|hooks|setup|init|bootstrap|migrate|upgrade|rules|config)
			return 1 ;;
		*) return 0 ;;
	esac
}

# Nearest .beads directory, walking up from $PWD. Honours an inherited BEADS_DIR (bd's own
# override). Pure bash — no subprocess — because this runs on every invocation including the
# read fast-path, which is otherwise a straight exec.
_locate_beads() {
	if [ -n "${BEADS_DIR:-}" ]; then _BD_BEADS_DIR="$BEADS_DIR"; return 0; fi
	local d="$PWD"
	while : ; do
		if [ -d "$d/.beads" ]; then _BD_BEADS_DIR="$d/.beads"; return 0; fi
		if [ "$d" = "/" ] || [ -z "$d" ]; then break; fi
		d=${d%/*}; [ -n "$d" ] || d="/"
	done
	_BD_BEADS_DIR=""
	return 1
}

# Pull dolt_mode / dolt_database out of metadata.json without forking: `$(<file)` is a bash
# builtin redirection and the rest is parameter expansion (bash 3.2 safe — no jq, no grep).
_read_beads_meta() {
	_BD_META_MODE=""; _BD_META_DB=""
	[ -n "$_BD_BEADS_DIR" ] && [ -r "$_BD_BEADS_DIR/metadata.json" ] || return 1
	local raw t
	raw=$(<"$_BD_BEADS_DIR/metadata.json")
	case "$raw" in *'"dolt_mode"'*)
		t=${raw#*\"dolt_mode\"}; t=${t#*:}; t=${t#*\"}; _BD_META_MODE=${t%%\"*} ;;
	esac
	case "$raw" in *'"dolt_database"'*)
		t=${raw#*\"dolt_database\"}; t=${t#*:}; t=${t#*\"}; _BD_META_DB=${t%%\"*} ;;
	esac
	return 0
}

# Is THIS HOST provisioned to run the shared beads Dolt server? Tested by the presence of
# ~/.beads/shared-server/beads-server.yaml — the config file homelab's `roles/beads_dolt`
# ansible role writes (never bd itself; see homelab BEADS.md "Where each piece lives"). Three
# candidates were considered:
#   - a live probe (connect to 127.0.0.1:3308, or `systemctl --user is-active
#     beads-dolt.service`): rejected outright — both fork a subprocess/socket, which this file's
#     portability bar forbids outside the already-subprocess-heavy mutating path, and this check
#     runs on `bootstrap`, which isn't that path.
#   - `~/.beads/shared-server/` (the parent dir) or its `dolt/` data dir: both are weaker
#     signals than the config file — the data dir in particular is where EVERY database's Dolt
#     files live (`<data_dir>/<db>`, see BEADS.md landmine #8), so it would keep reporting "yes"
#     forever after a decommission, long after the directory stopped meaning "there is a server
#     here". The config file is the one artifact the role's own install step (not steady-state
#     operation) is responsible for, making it the closer match for "is this host SET UP to run
#     the server" rather than "is data present" or "was the server ever started".
# A false positive (file present, server actually down or never started) is still safe: the
# caller below only ever turns it into env vars for `bd bootstrap`, and bootstrap against a dead
# server fails LOUD ("connection refused" against a real host:port) instead of today's silent
# wrong-database success — strictly better, which is the whole reason this guard exists.
_bd_shim_is_shared_server_host() {
	[ -r "$HOME/.beads/shared-server/beads-server.yaml" ]
}

# Pull the flat `dolt.database: "<name>"` key out of config.yaml — NOT nested under a `dolt:`
# mapping; verified against the three tracked config.yaml files this shim actually serves
# (dotfiles/tuidriver/umbel), which all write it as a bare top-level key, double-quoted, alone
# on its line. A `while read` loop over shell input redirection is a bash builtin (like
# _read_beads_meta's `$(<file)`, no grep/sed/cat) — this path isn't the hot path (it only runs
# for `bd bootstrap` on a fresh, not-yet-bootstrapped clone), but there's no reason to reach for
# a subprocess when a builtin does the job just as simply. Sets _BD_CFG_DB="" and returns 1 if
# the key is missing or the file can't be read; the caller turns that into an explicit error
# ("add the key") rather than falling back to any guessed name.
_read_config_database() {
	_BD_CFG_DB=""
	[ -n "$_BD_BEADS_DIR" ] && [ -r "$_BD_BEADS_DIR/config.yaml" ] || return 1
	local line
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in
			'dolt.database:'*)
				line=${line#dolt.database:}
				while [ "${line# }" != "$line" ]; do line=${line# }; done
				line=${line#\"}; line=${line%\"}
				_BD_CFG_DB="$line"
				;;
		esac
	done < "$_BD_BEADS_DIR/config.yaml"
	[ -n "$_BD_CFG_DB" ]
}

# Populate the coordinator's environment. State (lock/dirty/ts/log) is machine-local under
# $XDG_STATE_HOME and keyed per beads database — a global PATH shim must not let one repo's
# coordinator (holding the single-instance lock) swallow another repo's pending push.
#
# Keyed on the DATABASE, not the git worktree: on the shared Dolt server several worktrees of
# one repo resolve to a single database, and they must share one coordinator or two of them can
# commit/push concurrently. An embedded database lives inside the checkout, so there the .beads
# directory is the identity. cksum keeps the hashing POSIX.
_setup_state() {
	local ident key
	if [ "$_BD_META_MODE" = "server" ] && [ -n "$_BD_META_DB" ]; then
		ident="server:$_BD_META_DB"
	elif [ -n "$_BD_BEADS_DIR" ]; then
		ident="embedded:$_BD_BEADS_DIR"
	else
		ident="cwd:$PWD"
	fi
	key=$(printf '%s' "$ident" | cksum | cut -d' ' -f1)
	STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/bd-shim/$key"
	mkdir -p "$STATE_DIR" 2>/dev/null || true
	QUIET="${BD_SHIM_QUIET:-2}"
	LOCKFILE="$STATE_DIR/coord.lock"
	# Push payload is the REAL bd (never the shim -> no recursion). Log it so a failed
	# background push is diagnosable. %q quotes the path safely for the eval'd string.
	PUSH_CMD="$(printf '%q dolt push >>%q 2>&1' "$REAL_BD" "$STATE_DIR/push.log")"
	export STATE_DIR QUIET LOCKFILE PUSH_CMD
}

# Mark work owed, refresh the debounce anchor, and (re)spawn the detached coordinator.
# Returns instantly; safe to call on every trigger (the flock guard keeps one coordinator).
# setsid -> its own session, outlives this shell. perl takes a kernel flock(2) (portable;
# macOS has no flock(1)) HELD for the coordinator's whole life, with close-on-exec cleared so
# the lock survives the exec into bash. Any death (incl. SIGKILL) releases it — no stale
# artifact, no reaping race. A trigger whose perl can't take the lock exits 0 (stands down).
_flush_trigger() {
	: > "$STATE_DIR/dirty"
	_now > "$STATE_DIR/ts"
	local self; self=$(_self_path)
	( setsid perl -e '
		use Fcntl qw(:flock F_SETFD);
		open(my $f, ">", $ENV{LOCKFILE}) or exit 1;
		flock($f, LOCK_EX|LOCK_NB) or exit 0;
		fcntl($f, F_SETFD, 0);
		exec(@ARGV); exit 1;
	  ' bash "$self" "$_BD_SHIM_COORD_ARG" >/dev/null 2>&1 </dev/null & )
}

# Synchronous backstop: if a push is owed, run it to completion and wait. Used where a
# background coordinator won't survive (devbox cgroup teardown) or confirmation is required.
_flush_now() {
	if [ -e "$STATE_DIR/dirty" ]; then
		eval "$PUSH_CMD"
		local prc=$?
		rm -f "$STATE_DIR/dirty"
		return "$prc"
	fi
	return 1
}

# Coordinator body. Single-instance is guaranteed UPSTREAM by the perl flock guard, so there
# is no lock logic here. Debounce on (dirty flag + last-trigger ts) in integer seconds (no
# %N — portable). Loop until a full QUIET window passes with nothing owed; re-checking after
# each push absorbs triggers that raced the push (no tail loss). Exit releases the flock.
_coordinator_loop() {
	: "${STATE_DIR:?bd-shim coordinator: STATE_DIR unset}"
	: "${QUIET:=2}"
	: "${PUSH_CMD:?bd-shim coordinator: PUSH_CMD unset}"
	while :; do
		local now last
		now=$(_now)
		last=$(cat "$STATE_DIR/ts" 2>/dev/null || echo 0)
		if [ "$(( now - last ))" -ge "$QUIET" ]; then
			if [ -e "$STATE_DIR/dirty" ]; then
				eval "$PUSH_CMD"
				rm -f "$STATE_DIR/dirty"
			else
				exit 0
			fi
		fi
		sleep 1
	done
}

_bd_shim_main() {
	# Coordinator re-exec entrypoint (spawned detached by _flush_trigger).
	if [ "${1:-}" = "$_BD_SHIM_COORD_ARG" ]; then
		_coordinator_loop
		exit $?
	fi

	# Fork-bomb backstop. Self-exclusion in _find_real_bd relies on argv[0] being our
	# invocation path (true for zsh/bash PATH lookup — verified). Were a shell to pass a
	# bare argv[0], self-exclusion could misfire and the scan return THIS shim, recursing.
	# This turns that pathological case into a clean error. Normal nesting never nears 8.
	_BD_SHIM_DEPTH=$(( ${_BD_SHIM_DEPTH:-0} + 1 )); export _BD_SHIM_DEPTH
	if [ "$_BD_SHIM_DEPTH" -gt 8 ]; then
		printf 'bd-shim: aborting — recursive self-invocation (no real bd distinct from this shim). Set BD_REAL_BIN=/path/to/real/bd.\n' >&2
		exit 70
	fi

	REAL_BD="${BD_REAL_BIN:-$(_find_real_bd || true)}"
	if [ -z "$REAL_BD" ]; then
		printf 'bd-shim: cannot locate the real bd on PATH (set BD_REAL_BIN)\n' >&2
		exit 127
	fi

	# First non-flag token is the subcommand (cobra-style: global flags are --x=y).
	local a sub=""
	for a in "$@"; do
		case "$a" in
			-*) ;;
			*) sub="$a"; break ;;
		esac
	done

	_locate_beads || true
	_read_beads_meta || true

	# Fresh-clone guard. config.yaml is tracked; metadata.json is NOT (it records dolt_mode,
	# which differs per host — embedded on the Mac, server on the devbox). A checkout with the
	# former and not the latter is therefore a clone that was never bootstrapped, and bd's
	# behaviour there is to warn and fall back to the default database "beads" — i.e. report an
	# empty backlog and carry on. For an agent-facing tracker a silent "0 issues" is the worst
	# possible failure, so turn it into a loud one. Setup/diagnostic verbs are exempt, above all
	# `bootstrap`, which is the fix.
	if [ -n "$_BD_BEADS_DIR" ] && [ -z "$_BD_META_MODE" ] && [ -r "$_BD_BEADS_DIR/config.yaml" ]; then
		case "$sub" in
			bootstrap|init|migrate|upgrade|doctor|where|help|version|completion|setup|hooks|config|"") ;;
			*)
				printf 'bd-shim: %s has config.yaml but no metadata.json — this clone has never been bootstrapped.\n' "$_BD_BEADS_DIR" >&2
				printf 'bd-shim: refusing "bd %s", which would silently use the default database and report an empty backlog.\n' "$sub" >&2
				printf 'bd-shim: run `bd bootstrap` (or `bd bootstrap --dry-run` to see the plan first).\n' >&2
				exit 69
				;;
		esac

		# The guard above just exempted `bootstrap` — but on a shared-server host its own
		# advice is wrong. `bd bootstrap` has no --database flag (verified from its help); the
		# only way to name the target database is BEADS_DOLT_SHARED_SERVER=1 *and*
		# BEADS_DOLT_SERVER_DATABASE=<name> TOGETHER — bd 1.0.4 fails every partial combination
		# SILENTLY (neither -> embedded engine, database "beads"; shared-server var alone ->
		# shared engine, database still "beads"; database var alone -> embedded engine, a
		# throwaway local .beads/embeddeddolt/<name> nobody wants). See homelab BEADS.md
		# landmine #10. And bootstrap does not read THIS project's own tracked config.yaml
		# `dolt.database` to fill that gap (landmine #11) — despite config.yaml's own comment
		# insisting it does — because there is no metadata.json yet to establish the workspace
		# that reading would require. So: on a shared-server host, derive the name ourselves and
		# hand bootstrap both variables it needs, scoped to this one exec (never exported past
		# it, and this is a one-shot `exec` invocation with no parent shell to leak into anyway).
		#
		# Restricted to `bootstrap` alone, not the whole exemption list above:
		#   - it is the one verb landmine #10 is actually about, and the one this guard's exit-69
		#     message sends the user to run;
		#   - `init` looks similar but is a different code path for a BRAND-NEW project (flags,
		#     not env — see BEADS.md "Adding a new project"), and on this guard's own
		#     precondition (an EXISTING project's fresh clone) it fails on an already-existing
		#     database regardless (landmine #14) — these env vars would not rescue it;
		#   - `doctor`/`migrate`/`upgrade`/etc. are not documented anywhere as needing
		#     BEADS_DOLT_SERVER_DATABASE, and exporting BEADS_DOLT_SHARED_SERVER ambiently for a
		#     verb whose behaviour on a workspace-less checkout has never been verified is
		#     exactly the kind of guess this repo's landmines exist to warn against (landmine #1:
		#     the same var can auto-rewrite an unrelated embedded project's metadata.json to
		#     server mode).
		#
		# A caller who has already set EITHER var is left alone (both checked with -z below) —
		# same precedent as the shared-server-selection block just past this one: an explicit
		# override is deliberate, not a gap to paper over.
		if [ "$sub" = "bootstrap" ] && [ -z "${BEADS_DOLT_SHARED_SERVER:-}" ] \
			&& [ -z "${BEADS_DOLT_SERVER_DATABASE:-}" ] && _bd_shim_is_shared_server_host
		then
			if _read_config_database; then
				export BEADS_DOLT_SHARED_SERVER=1
				export BEADS_DOLT_SERVER_DATABASE="$_BD_CFG_DB"
			else
				printf 'bd-shim: %s/config.yaml has no dolt.database key.\n' "$_BD_BEADS_DIR" >&2
				printf 'bd-shim: this host runs the shared beads server, so bootstrap needs a database name from config.yaml — add a flat key, e.g. dolt.database: "%s", then re-run.\n' \
					"$(basename "$(dirname "$_BD_BEADS_DIR")")" >&2
				exit 69
			fi
		fi
	fi

	# Shared-server selection, PER PROJECT. bd only treats dolt_mode=server as the *shared*
	# server when BEADS_DOLT_SHARED_SERVER is set; without it the same metadata resolves to
	# "per-project" mode on port 0 and bd will spawn a stray server of its own. Exporting it
	# globally (e.g. from /etc/zsh/zshenv) is not an option: bd then auto-rewrites ANY embedded
	# project's metadata.json to dolt_mode=server ("Auto-repaired: dolt_mode updated to
	# server"), breaking every project not yet migrated. Deriving it from this project's own
	# metadata keeps migrations one-at-a-time and leaves embedded repos untouched.
	if [ "$_BD_META_MODE" = "server" ] && [ -z "${BEADS_DOLT_SHARED_SERVER:-}" ]; then
		export BEADS_DOLT_SHARED_SERVER=1
	fi

	# Reads / sync-plumbing / setup: exec the real bd — zero post-overhead and a perfect
	# passthrough of stdin/stdout/stderr/tty (matters for create-form and edit-in-$EDITOR).
	if ! _is_mutating "$sub"; then
		exec "$REAL_BD" "$@"
	fi

	# Mutating: run, preserve the real exit code, then flush — but only on success, since a
	# failed mutation changed nothing to sync.
	"$REAL_BD" "$@"
	local rc=$?
	if [ "$rc" -eq 0 ]; then
		_setup_state
		if [ -n "${BD_SHIM_SYNC:-}" ]; then
			: > "$STATE_DIR/dirty"; _now > "$STATE_DIR/ts"
			_flush_now >/dev/null 2>&1 || true   # local write already succeeded; sync is best-effort-but-awaited
		else
			_flush_trigger
		fi
	fi
	exit "$rc"
}

# Run main only when executed. When sourced (the test harness), just expose the functions.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
	_bd_shim_main "$@"
fi
