#!/usr/bin/env bash
# Compatibility shim for the retired ready-pool lister. The live workflow facade is Clerk;
# keep this executable only so old shell muscle memory gets routed to the supported verb.
set -uo pipefail

if [ "$#" -ne 0 ]; then
	printf "nextdelivery: retired; use 'clerk backlog next' (or 'clerk doctor' for setup)\n" >&2
	exit 2
fi

exec clerk backlog next
