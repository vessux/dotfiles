zsh/.zcompdump
zsh/.zcompdump.*
zsh/.zcompcache/
zsh/.zsh_history
zsh/.zsh_secrets
yazi/plugins/chmod.yazi
yazi/plugins/toggle-pane.yazi
karabiner/automatic_backups
tmux/plugins
# claude-code: whitelist, not blacklist. Everything in this dir is transient
# runtime state (sessions, cache, projects, daemon, uploads, skills, …) except
# the few config dirs/files below. Ignore all of it, then opt the tracked ones
# back in — so new runtime dirs Anthropic adds are ignored automatically.
claude-code/*
!claude-code/settings.json
!claude-code/commands/
!claude-code/hooks/
!claude-code/scripts/
!claude-code/setup/

# pi: whitelist, not blacklist. PI_CODING_AGENT_DIR points at
# ~/.config/pi/agent; auth, trust, sessions, package installs, logs, ad-hoc
# extensions, and future agent state should stay out of git by default.
pi/*
!pi/agent/
pi/agent/*
!pi/agent/settings.json
!pi/agent/keybindings.json
!pi/agent/AGENTS.md
!pi/agent/SYSTEM.md
!pi/agent/APPEND_SYSTEM.md
!pi/agent/extensions/
# Extension dirs are opt-in. Keep installed/generated extension contents ignored
# by default; a user-authored extension must include its own .gitignore that
# re-includes the source/lockfiles it wants tracked and ignores local artifacts.
pi/agent/extensions/*
!pi/agent/extensions/*/
pi/agent/extensions/*/*
!pi/agent/extensions/*/.gitignore
!pi/agent/skills/
pi/agent/skills/.gitkeep
!pi/agent/prompts/
pi/agent/prompts/.gitkeep
!pi/agent/themes/
pi/agent/themes/.gitkeep

# .claude/: this repo's project-local harness dir — distinct from the tracked
# claude-code/ global config above. The harness writes only transient state
# here (worktrees from EnterWorktree at .claude/worktrees/<name>, session
# state, …); nothing is meant to be committed. Blanket-ignore so a stray
# `git add -A` can't stage worktree contents. Whitelist later if repo-specific
# project config is ever wanted — see the claude-code/* block above.
.claude/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
# Two intentional overrides of beads' tracked-by-default files: the Dolt DB is
# the source of truth (synced to the git remote via refs/dolt/data), so —
#   - issues.jsonl: a ~60s-rewritten export, churny and redundant with Dolt.
#   - interactions.jsonl: a raw agent-interaction audit log, not worth publishing.
.beads/issues.jsonl
.beads/interactions.jsonl

# umbel: per-checkout bundle pin (local, re-created per machine)
.umbel-bundle

# delivery-superpowers: the location-override hook redirects superpowers'
# specs/plans here; machine-local, never committed. Slash-less so the hook's
# own `git check-ignore -q .local` probe passes before the dir exists.
.local
