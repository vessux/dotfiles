zsh/.zcompdump
zsh/.zcompdump.*
zsh/.zcompcache/
zsh/.zsh_history
zsh/.zsh_secrets
yazi/plugins/chmod.yazi
yazi/plugins/toggle-pane.yazi
karabiner/automatic_backups
tmux/plugins
# claude-code: whitelist, not blacklist. Everything in this dir is transient
# runtime state (sessions, cache, projects, daemon, uploads, skills, …) except
# the few config dirs/files below. Ignore all of it, then opt the tracked ones
# back in — so new runtime dirs Anthropic adds are ignored automatically.
claude-code/*
!claude-code/settings.json
!claude-code/commands/
!claude-code/hooks/
!claude-code/scripts/
!claude-code/setup/
