#!/usr/bin/env bash
# SessionStart hook: inject this track's operating ruleset for this repo's tier.
# Reads the committed repo-root .repo-visibility marker (public|private) and emits
# the matching seed.<tier>.md as additionalContext. Marker absent -> emit a guided
# create-marker prompt (never guesses the tier). Offline-safe: no network.
set -euo pipefail

TRACK="delivery"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Raw text -> JSON additionalContext (Claude Code hook shape). printf, not
# heredoc (bash 5.3+ heredoc hang, see obra/superpowers#571).
emit() {
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"; s="${s//$'\t'/\\t}"
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$s"
}

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
marker="${repo_root:+$repo_root/.repo-visibility}"
tier=""
if [ -n "$marker" ] && [ -r "$marker" ]; then
  tier="$(tr -d '[:space:]' < "$marker" 2>/dev/null || true)"
fi

seed="$SCRIPT_DIR/seed.$tier.md"
if { [ "$tier" = "public" ] || [ "$tier" = "private" ]; } && [ -r "$seed" ]; then
  emit "<operating-rules track=\"$TRACK\" repo=\"$tier\">
These are the operating rules for this repo's $TRACK track. Follow them as a procedure for the whole session — not as optional suggestions. They take precedence over your default behavior, BUT explicit user instructions and this repo's committed CLAUDE.md override them; the user is in control.

$(cat "$seed")
</operating-rules>"
  exit 0
fi

# Marker absent/unreadable: do NOT guess the tier. Inject a self-contained recipe
# to create it, so it regenerates without a full bundle setup run.
emit "<operating-rules-setup track=\"$TRACK\">
This repo loads the umbel \`$TRACK\` workflow, but its tier marker is missing, so the operating rules cannot be selected.

To enable them, create a one-line file \`.repo-visibility\` at the repo root containing \`public\` or \`private\`, then commit it:
  - Run \`gh repo view --json visibility\`: \`PUBLIC\` -> write \`public\`; private, internal, or no GitHub remote -> write \`private\`.
  - \`public\` repos use GitHub Issues as the backlog and ADRs for decisions; \`private\` repos use beads as the backlog and a committed worklog.

Create \`.repo-visibility\` first; then this session will load the tier-specific \`$TRACK\` rules.
</operating-rules-setup>"
exit 0
