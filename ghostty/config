# ssh-terminfo: auto-install the xterm-ghostty terminfo on remote hosts so tmux
# (which strictly looks up $TERM) works over SSH. ssh-env propagates a sane TERM.
# cursor/title kept (the usual defaults) since setting this key overrides them.
shell-integration-features = cursor,title,ssh-env,ssh-terminfo

theme = Catppuccin Mocha
font-size = 15
font-family = "Hack Nerd Font Mono"
background-blur-radius = 20
mouse-hide-while-typing = true
window-decoration = true
cursor-style-blink = false
cursor-invert-fg-bg = true
# keybind = global:cmd+/=toggle_quick_terminal
# macos-option-as-alt = true
# background-opacity = 0.7
# background-blur-radius = 20 
keybind = shift+enter=text:\n
